    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "316c37d5fe864e4bab912a0dbbe6b00a",
      "preview_id": "b93b8db2fc3e4cfeabc0e494db14ee2e"
    }
  ],
  "observability": { "enabled": true }
