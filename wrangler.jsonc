{
  "name": "ark-system",
  "compatibility_date": "2026-10-06",
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "SESSION"
    }
  ],
  "observability": { "enabled": true }
}