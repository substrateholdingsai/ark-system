# Normalize line endings — this repo is authored on Windows and built on Linux.
* text=auto eol=lf

*.js   text eol=lf
*.mjs  text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.svg  text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Never rewrite these
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary

# Lockfiles are generated — keep them out of review diffs
package-lock.json linguist-generated=true