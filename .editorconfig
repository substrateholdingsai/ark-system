root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Locked by Prettier — do not fight the formatter over these
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf