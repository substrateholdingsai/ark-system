# ─────────────────────────────────────────────────────────────────────────────
# Ark System — environment template
# Copy to `.env` for local Astro dev:  cp .env.example .env
# `.env` is gitignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# IMPORTANT — two different exposure models:
#
#   PUBLIC_*  Inlined into the client bundle at build time. Anything here is
#             VISIBLE to anyone who opens DevTools. Only put public IDs in it.
#
#   No prefix Server-only. Available in Pages Functions and SSR routes, and
#             readable in .astro frontmatter only when output is 'server'.
#             In a 100% static build these are NOT available in client code —
#             never ship them to the browser.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Analytics ───────────────────────────────────────────────────────────────
# Plausible: privacy-first, no cookies. See BaseLayout.astro <head>.
PUBLIC_PLAUSIBLE_DOMAIN=ark.systems

# ── Cal.com ─────────────────────────────────────────────────────────────────
# The booking link. The default lives in src/data/config.ts → contact.calComLink
# and is set there; override it here only for preview deployments.
# PUBLIC_CAL_LINK=https://cal.com/your-ark-team/30min

# ── Headless CMS (optional) ─────────────────────────────────────────────────
# Only needed if you wire up src/pages/portfolio.astro to a CMS.
# PUBLIC_SANITY_PROJECT_ID=
# PUBLIC_SANITY_DATASET=production

# ── Payments (SERVER ONLY — never prefix these) ─────────────────────────────
# Stripe secret key: dashboard → Developers → API keys. Use a Payment Link
# (https://buy.stripe.com/...) for a static site; no secret needed at all.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Mercado Pago access token: developers panel → Credentials.
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx

# BTCPay Server — self-hosted Bitcoin/Lightning payments.
# BTCPAY_URL=https://btcpay.example.com
# BTCPAY_API_KEY=xxxxxxxxxxxxxxxx

# ── Form endpoints (optional) ───────────────────────────────────────────────
# Formspree form ID — appears in the action attribute of the contact form.
# PUBLIC_FORMSPREE_FORM_ID=

# ── Canonical origin ────────────────────────────────────────────────────────
# Keep in sync with `site` in astro.config.mjs and config.site.url.
PUBLIC_SITE_URL=https://ark.systems