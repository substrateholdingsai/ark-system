---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import TechStack from '../components/sections/TechStack.astro';
import ConfiguredContent from '../components/sections/ConfiguredContent.astro';
import PricingTable from '../components/sections/PricingTable.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import { config } from '@/data/config';
---

<BaseLayout>
  <Hero />
  <ConfiguredContent />
  <TechStack />
  <PricingTable />
  <Section variant="void" padding="lg">
    <Container class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {config.finalCta.headline}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">{config.finalCta.subheadline}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button
          variant={
            config.finalCta.primary.variant === 'ghost' ? 'ghost' : config.finalCta.primary.variant
          }
          href={config.finalCta.primary.href}
          target={config.finalCta.primary.external ? '_blank' : undefined}
          rel={config.finalCta.primary.external ? 'noopener noreferrer' : undefined}
        >
          {config.finalCta.primary.label}
        </Button>
        {config.finalCta.secondary && (
          <Button
            variant={
              config.finalCta.secondary.variant === 'ghost'
                ? 'ghost'
                : config.finalCta.secondary.variant
            }
            href={config.finalCta.secondary.href}
            target={config.finalCta.secondary.external ? '_blank' : undefined}
            rel={config.finalCta.secondary.external ? 'noopener noreferrer' : undefined}
          >
            {config.finalCta.secondary.label}
          </Button>
        )}
        <Button
          variant="secondary"
          href="/portfolio"
        >
          Ver Portfolio →
        </Button>
      </div>
      {config.finalCta.microcopy && (
        <p class="mt-5 text-sm text-zinc-500">{config.finalCta.microcopy}</p>
      )}
    </Container>
  </Section>
</BaseLayout>
