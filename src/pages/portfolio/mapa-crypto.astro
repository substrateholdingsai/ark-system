---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import VirtualAssetsMapApp from '../../components/portfolio/VirtualAssetsMapApp.jsx';
---

<BaseLayout title="Mapa Crypto — Demo interactiva | Ark System">
  <Section id="portfolio-mapa-crypto" variant="void" padding="lg">
    <Container>
      <div class="mb-8 text-center">
        <a
          href="/portfolio"
          class="inline-flex items-center gap-2 font-mono text-sm text-zinc-500 transition-colors hover:text-white"
        >
          ← Volver al Portfolio
        </a>
        <h1 class="mt-6 text-4xl font-bold text-white sm:text-5xl">Mapa Crypto</h1>
        <p class="mx-auto mt-4 max-w-3xl rounded-lg border border-amber-400/30 bg-amber-400/10 p-3 text-sm text-amber-200">
          Prototipo educativo con temas y referencias no verificadas del material proporcionado. No
          es asesoría legal, no evalúa cumplimiento y no ofrece conclusiones sobre legalidad o
          sanciones.
        </p>
      </div>

      <VirtualAssetsMapApp client:only="react" />
    </Container>
  </Section>
</BaseLayout>
