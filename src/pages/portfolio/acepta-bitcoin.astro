---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
---

<BaseLayout title="Acepta Bitcoin — Portfolio | Ark System">
  <Section id="portfolio-acepta-bitcoin" variant="void" padding="lg">
    <Container>
      <div class="mb-12 text-center">
        <a
          href="/portfolio"
          class="inline-flex items-center gap-2 font-mono text-sm text-zinc-500 hover:text-white transition-colors"
        >
          ← Volver al Portfolio
        </a>
        <div class="mt-6">
          <span class="mb-2 block font-mono text-sm text-accent">
            CLIENTE 01 • EDUCACIÓN & DIRECTORIO
          </span>
          <h1 class="text-4xl font-bold text-white sm:text-5xl">Acepta Bitcoin</h1>
        </div>
        <p class="mx-auto mt-4 max-w-3xl text-lg leading-relaxed text-zinc-400">
          Portal educativo y directorio de comercios crypto-friendly en LatAm. Construido para
          ser la referencia de adopción de Bitcoin y Lightning Network en la región, conectando
          comercios que aceptan pagos soberanos con usuarios que buscan dónde gastar sus sats.
        </p>
      </div>

      <div class="mb-12 grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-border bg-surface/50 p-8">
          <h3 class="mb-4 font-mono text-sm text-accent">QUÉ RESUELVE</h3>
          <ul class="space-y-3 text-zinc-400">
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-1 h-2 w-2 rounded-full bg-accent"></span>
              <span>Visibilidad para comercios que aceptan Bitcoin</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-1 h-2 w-2 rounded-full bg-accent"></span>
              <span>Educación práctica sobre Lightning Network</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-1 h-2 w-2 rounded-full bg-accent"></span>
              <span>Directorio geolocalizado y filtrable</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-1 h-2 w-2 rounded-full bg-accent"></span>
              <span>Contenido evergreen optimizado para SEO</span>
            </li>
          </ul>
        </div>

        <div class="rounded-xl border border-border bg-surface/50 p-8">
          <h3 class="mb-4 font-mono text-sm text-accent">ARQUITECTURA</h3>
          <ul class="space-y-3 text-zinc-400">
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-1 h-2 w-2 rounded-full bg-accent"></span>
              <span>Astro 5 static-first + edge deployment</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-1 h-2 w-2 rounded-full bg-accent"></span>
              <span>Cloudflare Pages (300+ PoPs)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-1 h-2 w-2 rounded-full bg-accent"></span>
              <span>Content collections para directorio</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-1 h-2 w-2 rounded-full bg-accent"></span>
              <span>Zero JS por defecto, islas opcionales</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="mb-12 rounded-xl border border-border bg-surface/50 p-8">
        <h3 class="mb-4 font-mono text-sm text-accent">MÉTRICAS DE IMPACTO</h3>
        <div class="grid gap-6 sm:grid-cols-4">
          <div class="text-center">
            <div class="text-3xl font-bold text-white">500+</div>
            <div class="text-sm text-zinc-500">Comercios listados</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-white">15</div>
            <div class="text-sm text-zinc-500">Países LatAm</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-white">98</div>
            <div class="text-sm text-zinc-500">Lighthouse score</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-white">$0</div>
            <div class="text-sm text-zinc-500">Coste hosting/mes</div>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a
          href="https://www.aceptabitcoin.org"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-medium text-white hover:text-accent transition-colors"
        >
          Ver sitio en producción →
        </a>
      </div>
    </Container>
  </Section>
</BaseLayout>