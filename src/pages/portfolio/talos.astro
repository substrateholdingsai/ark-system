---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import TalosApp from '../../components/portfolio/TalosApp.jsx';
---

<BaseLayout title="Talos — Demo interactiva | Ark System">
  <Section id="portfolio-talos" variant="void" padding="lg">
    <Container>
      <div class="mb-8 text-center">
        <a
          href="/portfolio"
          class="inline-flex items-center gap-2 font-mono text-sm text-zinc-500 transition-colors hover:text-white"
        >
          ← Volver al Portfolio
        </a>
        <h1 class="mt-6 text-4xl font-bold text-white sm:text-5xl">Talos</h1>
        <p class="mx-auto mt-4 max-w-3xl rounded-lg border border-amber-400/30 bg-amber-400/10 p-3 text-sm text-amber-200">
          Prototipo visual: colector, métricas, señales, API y arquitectura son ilustrativos. No hay
          datos en vivo, tesorería, operaciones de trading, cobros ni servicios financieros.
        </p>
        <p class="mx-auto mt-3 max-w-3xl text-xs text-zinc-400">
          No es asesoría financiera ni de inversión. Los valores de la interfaz se generan
          localmente para la demostración.
        </p>
      </div>

      <TalosApp client:only="react" />
    </Container>
  </Section>
</BaseLayout>
