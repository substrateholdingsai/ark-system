---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import { config } from '@/data/config';
---

<BaseLayout title={`404 - Page Not Found | ${config.brand.name}`}>
  <Section variant="void" padding="xl">
    <Container class="text-center">
      <!-- Error Code -->
      <div class="relative inline-block mb-8">
        <h1 class="text-[120px] sm:text-[180px] font-bold tracking-tighter text-white/5 leading-none select-none">
          404
        </h1>
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-6xl sm:text-8xl font-bold tracking-tight text-ark-accent">◆</span>
        </div>
      </div>
      <h2 class="mt-6 text-3xl font-bold sm:text-4xl text-white">
        This edge location doesn't exist.
      </h2>
      <p class="mt-4 text-zinc-400">
        The link may be outdated. Try the homepage or head back to our work.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button variant="primary" href="/">
          Go home
        </Button>
        <Button variant="secondary" href="/portfolio">
          See our work
        </Button>
      </div>
    </Container>
  </Section>
</BaseLayout>
