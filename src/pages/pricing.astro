---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingTable from '../components/sections/PricingTable.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { config } from '@/data/config';

const line = config.theme.default ?? 'legal';
const page = config.pricingPage;
---

<BaseLayout
  title={`Precios | ${config.brand.name}`}
  description={page.hero.subheadline}
  line={line}
>
  <Section variant="void" padding="lg" line={line} labelledBy="pricing-hero-heading">
    <Container class="text-center">
      <Badge variant="line" dot class="mb-4">
        {page.hero.badge}
      </Badge>
      <h1
        id="pricing-hero-heading"
        class="font-display text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl"
      >
        {page.hero.headline}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-text-muted">{page.hero.subheadline}</p>
    </Container>
  </Section>

  <PricingTable />

  <Section variant="default" padding="lg" line={line} labelledBy="pricing-comparison-heading">
    <Container>
      <div class="mb-12 text-center">
        <Badge class="mb-4">{page.comparison.badge}</Badge>
        <h2
          id="pricing-comparison-heading"
          class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
        >
          {page.comparison.headline}
        </h2>
        <p class="mt-4 text-text-muted">{page.comparison.subheadline}</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {page.comparison.items.map((item) => (
          <Card
            padding="lg"
            variant={item.tone === 'positive' ? 'elevated' : 'default'}
            line={item.tone === 'positive' ? line : undefined}
            class={item.tone === 'positive' ? 'border-ark-accent/30' : ''}
          >
            <h3
              class:list={[
                'mb-3 text-lg font-bold',
                item.tone === 'positive' ? 'text-ark-accent' : 'text-white',
              ]}
            >
              {item.name}
            </h3>
            <ul class="space-y-2 text-sm">
              {item.bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <span
                    class:list={[
                      'mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-[10px] font-bold',
                      item.tone === 'positive'
                        ? 'bg-emerald-500/10 text-emerald-400'
                        : 'bg-red-500/10 text-red-400',
                    ]}
                    aria-hidden="true"
                  >
                    {item.tone === 'positive' ? '✓' : '×'}
                  </span>
                  <span class={item.tone === 'positive' ? 'text-white' : 'text-text-muted'}>
                    {bullet}
                  </span>
                </li>
              ))}
            </ul>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <Section variant="surface" padding="lg" line={line} labelledBy="pricing-faq-heading">
    <Container>
      <div class="mb-12 text-center">
        <Badge class="mb-4">{page.faqs.badge}</Badge>
        <h2
          id="pricing-faq-heading"
          class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
        >
          {page.faqs.headline}
        </h2>
      </div>

      <div class="mx-auto max-w-3xl space-y-3">
        {page.faqs.items.map((faq) => (
          <details class="group rounded-xl border border-white/[0.06] bg-surface/40 backdrop-blur-md transition-colors hover:border-white/[0.10]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5">
              <span class="text-base font-semibold text-white">{faq.q}</span>
              <svg
                class="h-4 w-4 shrink-0 text-text-muted transition-transform group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="border-t border-white/[0.04] px-5 py-4">
              <p class="text-sm leading-relaxed text-text-muted">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </Container>
  </Section>

  <Section variant="void" padding="lg" line={line} labelledBy="pricing-cta-heading">
    <Container class="text-center">
      <h2
        id="pricing-cta-heading"
        class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl"
      >
        {page.finalCta.headline}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-text-muted">{page.finalCta.subheadline}</p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button
          variant={page.finalCta.primary.variant ?? 'primary'}
          size="lg"
          href={page.finalCta.primary.href}
          target={page.finalCta.primary.external ? '_blank' : undefined}
          rel={page.finalCta.primary.external ? 'noopener noreferrer' : undefined}
        >
          {page.finalCta.primary.label}
        </Button>
        <Button
          variant={page.finalCta.secondary.variant ?? 'secondary'}
          size="lg"
          href={page.finalCta.secondary.href}
          target={page.finalCta.secondary.external ? '_blank' : undefined}
          rel={page.finalCta.secondary.external ? 'noopener noreferrer' : undefined}
        >
          {page.finalCta.secondary.label}
        </Button>
      </div>

      <p class="mt-4 text-xs text-text-muted">{page.finalCta.microcopy}</p>

      <div class="mt-8 flex items-center justify-center gap-2 text-[10px] text-text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-[#F38020]" aria-hidden="true"></span>
        <span class="font-mono">{config.footer.foundation}</span>
      </div>
    </Container>
  </Section>
</BaseLayout>
