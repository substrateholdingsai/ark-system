---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Portafolio | Ark System">
  <Section id="portfolio" variant="void" padding="lg">
    <Container>
      <div class="mb-16 text-center">
        <p class="mb-3 font-mono text-sm uppercase tracking-widest text-accent">
          Tecnología que impulsa negocios reales
        </p>
        <h1 class="mb-6 text-4xl font-bold text-white sm:text-5xl">Casos de Éxito</h1>
        <p class="mx-auto max-w-3xl text-lg leading-relaxed text-zinc-400">
          Diseñamos experiencias rápidas y confiables con arquitectura edge-native: aplicaciones
          serverless que escalan con la demanda, entregan contenido cerca de cada cliente y conectan
          pagos modernos con los canales de venta que las personas ya usan.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        <article class="group relative overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-300 hover:border-accent/50 hover:shadow-xl">
          <div class="aspect-video relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-accent/20 via-transparent to-transparent group-hover:from-accent/30 transition-all duration-500" />
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="font-mono text-6xl font-bold text-accent/10 group-hover:text-accent/20 transition-colors">⚡</span>
            </div>
          </div>
          <div class="p-8">
            <div class="mb-4 flex items-center justify-between gap-4">
              <span class="font-mono text-sm text-accent">CLIENTE 02 • E-COMMERCE EDGE</span>
              <a
                href="https://temozonia.com"
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-sm text-zinc-500 transition-colors hover:text-white"
              >
                Sitio real →
              </a>
            </div>
            <h2 class="mb-4 text-2xl font-bold text-white group-hover:text-accent transition-colors">
              Temozonia Carnes Ahumadas
            </h2>
            <p class="mb-6 text-zinc-400">
              Tienda D2C con checkout híbrido: Lightning Network + WhatsApp Business.
              Infraestructura serverless en el edge para picos de tráfico sin servidores dedicados.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="rounded-full border border-border px-3 py-1 text-xs text-zinc-500">Astro 5</span>
              <span class="rounded-full border border-border px-3 py-1 text-xs text-zinc-500">React 19</span>
              <span class="rounded-full border border-border px-3 py-1 text-xs text-zinc-500">Lightning</span>
              <span class="rounded-full border border-border px-3 py-1 text-xs text-zinc-500">Edge</span>
            </div>
            <Button variant="secondary" href="/portfolio/temozonia" class="w-full sm:w-auto">
              Ver demo interactiva
            </Button>
          </div>
        </article>

        <article class="group relative overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-300 hover:border-accent/50 hover:shadow-xl">
          <div class="aspect-video relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-orange-500/20 via-transparent to-transparent group-hover:from-orange-500/30 transition-all duration-500" />
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="font-mono text-6xl font-bold text-orange-500/10 group-hover:text-orange-500/20 transition-colors">₿</span>
            </div>
          </div>
          <div class="p-8">
            <div class="mb-4 flex items-center justify-between gap-4">
              <span class="font-mono text-sm text-accent">CLIENTE 01 • EDUCACIÓN & DIRECTORIO</span>
              <a
                href="https://www.aceptabitcoin.org"
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-sm text-zinc-500 transition-colors hover:text-white"
              >
                Sitio real →
              </a>
            </div>
            <h2 class="mb-4 text-2xl font-bold text-white group-hover:text-accent transition-colors">
              Acepta Bitcoin
            </h2>
            <p class="mb-6 text-zinc-400">
              Portal educativo y directorio de comercios crypto-friendly en LatAm. 500+ comercios
              listados en 15 países, construido sobre arquitectura estática edge-native.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="rounded-full border border-border px-3 py-1 text-xs text-zinc-500">Astro 5</span>
              <span class="rounded-full border border-border px-3 py-1 text-xs text-zinc-500">Content Collections</span>
              <span class="rounded-full border border-border px-3 py-1 text-xs text-zinc-500">SEO técnico</span>
              <span class="rounded-full border border-border px-3 py-1 text-xs text-zinc-500">Edge</span>
            </div>
            <Button variant="secondary" href="/portfolio/acepta-bitcoin" class="w-full sm:w-auto">
              Ver caso de estudio
            </Button>
          </div>
        </article>
      </div>

      <div class="mt-16 text-center">
        <p class="mb-4 font-mono text-sm text-zinc-500">
          ¿Quieres ser el próximo caso de éxito?
        </p>
        <Button
          variant="primary"
          href="https://cal.com/pablo-cortes-wuzivu/15min"
          target="_blank"
          rel="noopener noreferrer"
        >
          Agendar demo →
        </Button>
      </div>
    </Container>
  </Section>
</BaseLayout>