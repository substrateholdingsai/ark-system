---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioGrid from '../components/sections/PortfolioGrid.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import { config } from '@/data/config';
---

<BaseLayout title="Portfolio | Ark">
  <!-- Hero Section -->
  <Section variant="void" padding="lg">
    <Container class="text-center">
      <Badge class="mb-4">Our Work</Badge>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Frictionless by design.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-zinc-400">
        See how the Ark engine adapts to different industries while maintaining 100/100 Lighthouse
        performance and zero maintenance overhead.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button variant="primary" href={config.contact.bookingUrl}>
          Start Your Project
        </Button>
        <Button variant="secondary" href="/pricing">
          View Pricing
        </Button>
      </div>
    </Container>
  </Section>

  <!-- Portfolio Grid -->
  <PortfolioGrid />

  <!-- CTA Section -->
  <Section variant="surface" padding="lg">
    <Container class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Ready to build your Ark?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">
        From concept to edge-deployed in days, not months. No monthly fees, no platform lock-in, no
        maintenance headaches.
      </p>
      <div class="mt-8">
        <Button variant="primary" href={config.contact.bookingUrl}>
          Book a Consultation
        </Button>
      </div>
    </Container>
  </Section>
</BaseLayout>
