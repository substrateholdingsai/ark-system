---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import { config } from '@/data/config';

const portfolioByLine = {
  legal: config.portfolio.filter((item) => item.line === 'legal'),
  commerce: config.portfolio.filter((item) => item.line === 'commerce'),
  lab: config.portfolio.filter((item) => item.line === 'lab'),
};

const lines = [
  {
    id: 'legal',
    label: 'ARK LEGAL',
    headline: 'Nuestra bandera',
    tagline: 'Cumplimiento documental y análisis jurídico.',
    items: portfolioByLine.legal,
  },
  {
    id: 'commerce',
    label: 'ARK COMMERCE',
    headline: 'Nuestro flujo',
    tagline: 'Sitios de alto rendimiento para negocios.',
    items: portfolioByLine.commerce,
  },
  {
    id: 'lab',
    label: 'ARK LAB',
    headline: 'Nuestro I+D',
    tagline: 'Datos, Bitcoin y agentes inteligentes.',
    items: portfolioByLine.lab,
  },
];

const totalLegal = portfolioByLine.legal.length;
const totalCommerce = portfolioByLine.commerce.length;
const totalLab = portfolioByLine.lab.length;
const totalItems = config.portfolio.length;
---

<BaseLayout title="Portafolio | Ark Systems">
  <Section id="portfolio" variant="void" padding="lg" class="bg-void">
    <Container>
      <div class="mb-12 max-w-[720px] text-left">
        <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-[11px] font-bold tracking-widest text-zinc-300">
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
          {totalItems} FICHAS • {totalLegal} ARK LEGAL • {totalCommerce} ARK COMMERCE • {totalLab}{' '}
          ARK LAB
        </div>
        <h1 class="font-display mt-6 text-4xl font-black leading-[0.9] tracking-[-0.03em] text-white sm:text-5xl lg:text-[56px]">
          Portafolio Ark
          <br />
          <span class="text-ark-accent">tres líneas, un cimiento</span>
        </h1>
        <p class="mt-5 max-w-[52ch] text-base leading-7 text-zinc-400 sm:text-lg">
          Ark Legal es nuestra bandera: cumplimiento documental para despachos. Ark Commerce es
          nuestro flujo: sitios de alto rendimiento para negocios. Ark Lab es nuestro I+D. Todas
          corren sobre el mismo cimiento: Cloudflare Edge.
        </p>
      </div>

      {lines.map((line) => (
        <section data-theme={line.id} class="mb-20 last:mb-0" aria-labelledby={`line-${line.id}`}>
          <div class="mb-8 flex flex-col gap-3 border-b border-white/[0.06] pb-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <div class="flex items-center gap-3">
                <span class="rounded-full border border-ark-accent/30 bg-ark-accent/[0.08] px-3 py-1 text-[10px] font-black tracking-widest text-ark-accent">
                  {line.label}
                </span>
                <span class="text-[11px] font-bold uppercase tracking-widest text-zinc-500">
                  {line.headline}
                </span>
              </div>
              <h2
                id={`line-${line.id}`}
                class="font-display mt-3 text-2xl font-black tracking-tight text-white sm:text-3xl"
              >
                {line.tagline}
              </h2>
            </div>
            <div class="text-[11px] font-mono text-zinc-500">
              {line.items.length} {line.items.length === 1 ? 'ficha' : 'fichas'}
            </div>
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {line.items.map((item) => (
              <article class="group relative flex flex-col overflow-hidden rounded-[20px] border border-white/[0.06] bg-[#0A0A0B] transition-all duration-300 hover:border-ark-accent/30 hover:shadow-[0_20px_60px_rgba(0,0,0,0.4)]">
                <div class="relative aspect-[16/10] overflow-hidden bg-zinc-900">
                  <img
                    src={item.image}
                    alt={item.name}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                  <div
                    class="absolute inset-0 opacity-60 transition-opacity group-hover:opacity-70"
                    style="background: linear-gradient(135deg, hsl(var(--ark-accent) / 0.3), transparent 70%)"
                    aria-hidden="true"
                  ></div>

                  <div class="absolute left-3 top-3">
                    <span class="rounded-full border border-ark-accent/40 bg-black/70 px-2.5 py-1 text-[10px] font-black tracking-widest text-white backdrop-blur">
                      {line.label}
                    </span>
                  </div>
                  {item.tags[0] && (
                    <div class="absolute right-3 top-3">
                      <span class="rounded-full bg-white px-2.5 py-1 text-[10px] font-bold text-black">
                        {item.tags[0]}
                      </span>
                    </div>
                  )}
                  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent p-3">
                    <div class="text-[10px] font-bold uppercase tracking-widest text-white/60">
                      {item.tags.slice(0, 3).join(' • ')}
                    </div>
                  </div>
                </div>

                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="font-display text-[18px] font-bold leading-tight tracking-[-0.01em] text-white transition-colors group-hover:text-ark-accent">
                      {item.name}
                    </h3>
                    {item.realUrl && (
                      <a
                        href={item.realUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="shrink-0 font-mono text-[11px] text-zinc-500 transition-colors hover:text-white"
                      >
                        Sitio externo →
                      </a>
                    )}
                  </div>

                  <p class="mt-3 line-clamp-3 text-[13px] leading-5 text-zinc-400">
                    {item.description}
                  </p>

                  {item.seals && item.seals.length > 0 && (
                    <div class="mt-4 space-y-2">
                      {item.seals.map((seal) => (
                        <div class="ark-seal">
                          <span class="ark-seal__label">{seal.label}</span>
                          <span class="ark-seal__value font-mono text-xs">{seal.value}</span>
                        </div>
                      ))}
                    </div>
                  )}

                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {item.tags.slice(0, 3).map((tag) => (
                      <span class="rounded-full border border-white/[0.06] bg-white/[0.02] px-2.5 py-1 text-[10px] font-medium text-zinc-500">
                        {tag}
                      </span>
                    ))}
                  </div>

                  {item.disclaimer && (
                    <p class="mt-4 text-[10px] leading-tight text-zinc-500">{item.disclaimer}</p>
                  )}

                  <div class="mt-6 flex flex-col gap-3">
                    {item.available === false || !item.url ? (
                      <Button
                        variant="secondary"
                        href={config.contact.bookingUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="h-10 flex-1 justify-center border-white/10 bg-white/[0.06] text-[13px] font-bold text-white hover:bg-white/[0.10]"
                      >
                        Solicitar plantilla
                      </Button>
                    ) : (
                      <Button
                        variant={line.id === 'legal' ? 'primary' : 'secondary'}
                        href={item.url}
                        target={item.url.startsWith('http') ? '_blank' : undefined}
                        rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                        class={`h-10 flex-1 justify-center text-[13px] font-bold ${
                          line.id === 'legal'
                            ? ''
                            : 'border-white/10 bg-white/[0.06] text-white hover:bg-white/[0.10]'
                        }`}
                      >
                        {line.id === 'legal' ? 'Ver análisis →' : 'Ver demo →'}
                      </Button>
                    )}

                    <div class="flex items-center gap-2 text-[10px] text-zinc-500">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#F38020]"></span>
                      <span class="font-mono">Cloudflare Edge</span>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}

      <div class="mt-16 flex flex-col items-start justify-between gap-6 rounded-[24px] border border-white/[0.08] bg-surface p-8 sm:flex-row sm:items-center sm:p-10">
        <div>
          <div class="text-[11px] font-black tracking-widest text-zinc-500">
            ¿TIENE UN CASO QUE RESOLVER?
          </div>
          <div class="font-display mt-2 text-2xl font-black tracking-tight text-white">
            Demo 3 min con su propio expediente
          </div>
          <div class="mt-2 max-w-[52ch] text-sm text-zinc-400">
            Agendamos 15 min. Definimos su caso piloto. Le mostramos cómo se ve su expediente
            ordenado, con trazabilidad, en el Edge. Sin CAPEX. Sin instalar nada.
          </div>
          <div class="mt-4 flex items-center gap-2 text-[11px] text-zinc-500">
            <span class="h-1.5 w-1.5 rounded-full bg-[#F38020]"></span>
            <span class="font-mono">
              Cimiento: Cloudflare Edge · 300+ ciudades · SSL automático
            </span>
          </div>
        </div>
        <Button
          variant="primary"
          href={config.contact.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="h-12 shrink-0 px-6 font-black"
        >
          Solicitar demo 3 min →
        </Button>
      </div>
    </Container>
  </Section>
</BaseLayout>
