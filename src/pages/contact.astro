---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Contacto | Ark System">
  <Section id="contact" class="bg-void py-24">
    <Container>
      <div class="max-w-2xl mx-auto text-center mb-16">
        <h2 class="text-4xl font-bold text-white mb-4">Hablemos de tu proyecto</h2>
        <p class="text-zinc-400">Estamos listos para llevar tu infraestructura al siguiente nivel.</p>
      </div>

      <form id="contact-form" class="space-y-6 max-w-lg mx-auto">
        <Input 
          label="Nombre" 
          type="text" 
          name="name" 
          placeholder="Tu nombre completo" 
          required 
        />
        <Input 
          label="Email" 
          type="email" 
          name="email" 
          placeholder="tu@empresa.com" 
          required 
        />
        <div class="space-y-2">
          <label class="block text-sm font-medium text-zinc-300">Mensaje</label>
          <textarea 
            name="message" 
            rows={4} 
            class="w-full bg-surface border border-border rounded-lg px-4 py-3 text-white focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-colors"
            placeholder="Cuéntanos sobre tu idea..."
            required
          ></textarea>
        </div>
        
        <Button type="submit" class="w-full">Enviar Mensaje</Button>
        
        <div id="form-status" class="hidden text-center mt-4"></div>
      </form>
    </Container>
  </Section>

  <script is:inline>
    /** @type {HTMLFormElement} */
    const form = document.getElementById('contact-form');
    /** @type {HTMLDivElement} */
    const statusDiv = document.getElementById('form-status');
    /** @type {HTMLButtonElement} */
    const submitBtn = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const originalText = submitBtn.innerText;
      
      submitBtn.disabled = true;
      submitBtn.innerText = 'Enviando...';
      statusDiv.classList.add('hidden');

      try {
        const formData = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (response.ok) {
          statusDiv.innerText = '¡Mensaje enviado con éxito! Nos pondremos en contacto pronto.';
          statusDiv.className = 'text-center mt-4 text-emerald-500 font-medium';
          form.reset();
        } else {
          throw new Error(data.error || 'Error al enviar');
        }
      } catch (_error) {
        statusDiv.innerText = 'Hubo un error. Por favor intenta de nuevo.';
        statusDiv.className = 'text-center mt-4 text-red-500 font-medium';
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = originalText;
        statusDiv.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>