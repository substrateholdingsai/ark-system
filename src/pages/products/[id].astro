---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import Button from '../../components/ui/Button.astro';
import { products } from '@/data/config';

export function getStaticPaths() {
  return products.map((p) => ({ params: { id: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
---

<BaseLayout title={product.name} description={product.tagline}>
  <Section variant="void" padding="lg">
    <Container>
      <div class="max-w-[720px]">
        <div class="text-[11px] font-black tracking-widest text-zinc-500">PRODUCTO</div>
        <h1 class="mt-3 text-4xl font-black tracking-tight text-white sm:text-5xl">
          {product.name}
        </h1>
        <p class="mt-4 text-base leading-7 text-zinc-400">{product.tagline}</p>
        <dl class="mt-6 space-y-2 text-sm">
          <div class="flex gap-2">
            <dt class="font-bold text-zinc-500">Dominio</dt>
            <dd class="text-zinc-300">{product.domain ?? '—'}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-bold text-zinc-500">TAM</dt>
            <dd class="text-zinc-300">{product.tam}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-bold text-zinc-500">Revenue</dt>
            <dd class="text-zinc-300">{product.revenue}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-bold text-zinc-500">Maturity</dt>
            <dd class="text-zinc-300">{product.maturity}</dd>
          </div>
        </dl>
        {product.absorbedInto && (
          <p class="mt-4 text-sm text-zinc-400">Absorbido en: {product.absorbedInto.join(', ')}</p>
        )}
        <div class="mt-6 flex flex-wrap gap-3">
          {product.ctaDomain && (
            <Button
              variant="primary"
              href={product.ctaDomain}
              target="_blank"
              rel="noopener noreferrer"
              class="h-10 px-4 text-[13px] font-bold"
            >
              Ir al dominio
            </Button>
          )}
          <Button
            variant="ghost"
            href="/products"
            class="h-10 border-white/10 bg-white/[0.06] px-4 text-[13px] font-bold text-white hover:bg-white/[0.1]"
          >
            Volver a productos
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
