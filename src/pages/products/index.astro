---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import Button from '../../components/ui/Button.astro';
import { products } from '@/data/config';
---

<BaseLayout title="Productos" description="Los siete productos de la plataforma ARK.">
  <Section variant="void" padding="lg">
    <Container>
      <div class="mb-10 max-w-[720px]">
        <div class="text-[11px] font-black tracking-widest text-zinc-500">PRODUCTOS</div>
        <h1 class="mt-3 text-4xl font-black tracking-tight text-white sm:text-5xl">
          Siete productos. Un sustrato.
        </h1>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <article class="flex flex-col rounded-[20px] border border-white/[0.06] bg-[#0A0A0B] p-6">
            <h2 class="text-xl font-black text-white">{p.name}</h2>
            <p class="mt-2 text-sm text-zinc-400">{p.tagline}</p>
            <p class="mt-3 text-[12px] text-zinc-500">{p.maturity}</p>
            <div class="mt-4">
              <Button variant="primary" href={p.ctaProduct} class="h-9 px-3 text-[12px] font-bold">
                Ver producto
              </Button>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
