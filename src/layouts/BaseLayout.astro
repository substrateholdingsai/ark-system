---
import '../styles/global.css';
import Seo from '../components/layout/Seo.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { config, pageTitle } from '../data/config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  line?: 'legal' | 'commerce' | 'lab';
  keywords?: string[];
  noindex?: boolean;
}

const {
  title = pageTitle,
  description = config.hero.subheadline,
  image,
  type,
  line,
  keywords,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang={config.locale} data-theme={config.theme.default}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <!--
      favicon.svg es la fuente de verdad (la genera scripts/generate-assets.py) y
      la usan los navegadores modernos; el .ico cubre a los que no leen SVG y
      apple-touch-icon.png es el ícono de home screen de iOS, que exige PNG
      opaco. Regenerar rasters: npm run favicon.
    -->
    <link rel="icon" type="image/svg+xml" href={config.brand.faviconSrc} sizes="any" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/vector/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      line={line}
      keywords={keywords}
      noindex={noindex}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
