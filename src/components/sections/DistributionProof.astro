---
import { distribution } from '@/data/config';
---

<section id="casos-de-exito" class="border-b border-eterea-border bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-12 max-w-3xl">
      <div class="mono inline-block rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-eterea-blue">
        TRACCIÓN EN PRODUCCIÓN · CASOS DE ÉXITO
      </div>
      <h2 class="instrument mt-3 text-4xl text-eterea-text sm:text-5xl lg:text-6xl">
        Soluciones probadas en <span class="italic text-eterea-blue">organizaciones de alta exigencia.</span>
      </h2>
      <p class="mt-4 text-base leading-relaxed text-eterea-muted sm:text-lg">
        Ark Systems no es un proyecto de laboratorio. Nuestro motor operativo respalda portales gremiales e institucionales masivos y fondos corporativos de inversión privada en México.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <!-- Case Study 1: CANACO SERVYTUR Mérida -->
      <article class="flex flex-col justify-between rounded-3xl border border-[#DCE7FF] bg-gradient-to-br from-[#FAFCFF] to-white p-8 shadow-sm transition-all hover:border-blue-400 hover:shadow-eterea-card">
        <div>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="mono rounded-full bg-blue-100/70 px-3 py-1 text-xs font-semibold text-blue-700">
              CASO INSTITUCIONAL INSIGNIA
            </span>
            <span class="mono text-xs text-slate-500">Mérida, Yucatán</span>
          </div>

          <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            {distribution.canaco.name}
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">
            {distribution.canaco.blurb}
          </p>

          <div class="mt-6 rounded-2xl border border-slate-100 bg-[#F5F8FF] p-5">
            <div class="mono text-xs font-semibold uppercase text-slate-500">Capacidades desplegadas:</div>
            <ul class="mt-3 space-y-2 text-xs sm:text-sm text-slate-700">
              <li class="flex items-start gap-2">
                <span class="h-1.5 w-1.5 mt-2 rounded-full bg-eterea-blue shrink-0"></span>
                <span>Padrón empresarial digital con credenciales dinámicas QR</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="h-1.5 w-1.5 mt-2 rounded-full bg-eterea-blue shrink-0"></span>
                <span>Buzón fiscal inteligente y emisión CFDI 4.0 automatizada</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="h-1.5 w-1.5 mt-2 rounded-full bg-eterea-blue shrink-0"></span>
                <span>Cobro federado de cuotas y servicios con liquidación vía Stripe Connect</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={distribution.canaco.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-eterea-blue px-5 py-3 text-xs font-semibold text-white shadow-sm transition-all hover:bg-blue-700"
          >
            Explorar portal de socios CANACO ↗
          </a>
          <span class="mono text-xs text-slate-500">
            canacomérida.com.mx
          </span>
        </div>
      </article>

      <!-- Case Study 2: Futura Capital -->
      <article class="flex flex-col justify-between rounded-3xl border border-[#DCE7FF] bg-gradient-to-br from-[#FAFCFF] to-white p-8 shadow-sm transition-all hover:border-blue-400 hover:shadow-eterea-card">
        <div>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="mono rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700">
              CASO CORPORATIVO & FINANCIERO
            </span>
            <span class="mono text-xs text-slate-500">Sector Financiero</span>
          </div>

          <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            Futura Capital
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">
            Plataforma financiera corporativa con back-office unificado, gestión documental con cumplimiento regulatorio estricto y trazabilidad de operaciones sobre cadena de bloques interna.
          </p>

          <div class="mt-6 rounded-2xl border border-slate-100 bg-[#F5F8FF] p-5">
            <div class="mono text-xs font-semibold uppercase text-slate-500">Capacidades desplegadas:</div>
            <ul class="mt-3 space-y-2 text-xs sm:text-sm text-slate-700">
              <li class="flex items-start gap-2">
                <span class="h-1.5 w-1.5 mt-2 rounded-full bg-indigo-600 shrink-0"></span>
                <span>Expediente digital único de inversionistas y clientes</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="h-1.5 w-1.5 mt-2 rounded-full bg-indigo-600 shrink-0"></span>
                <span>Firma electrónica con constancia de conservación NOM-151</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="h-1.5 w-1.5 mt-2 rounded-full bg-indigo-600 shrink-0"></span>
                <span>Conciliación automática y reportes de rentabilidad en tiempo real</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact?case=futura"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-xs font-semibold text-slate-800 transition-all hover:border-slate-300 hover:bg-slate-50"
          >
            Solicitar briefing técnico
          </a>
          <span class="mono text-xs text-slate-500">
            Sector Private Equity & Corporativo
          </span>
        </div>
      </article>
    </div>

    <!-- Institutional Rails -->
    <div class="mt-12">
      <div class="mono mb-4 text-center text-xs font-semibold uppercase tracking-wider text-slate-400">
        Rieles Institucionales de Integración
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {distribution.rails.map((r) => (
          <span class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-800 shadow-sm">
            {r.name}
            <span class="ml-2 font-normal text-slate-500">{r.blurb}</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
