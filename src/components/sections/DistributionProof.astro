---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import Button from '../ui/Button.astro';
import { distribution } from '@/data/config';
---

<Section variant="surface" padding="lg">
  <Container>
    <div class="mx-auto max-w-[720px] text-center">
      <div class="text-[11px] font-black tracking-widest text-zinc-500">CANAL INSTITUCIONAL</div>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-white sm:text-4xl">
        {distribution.canaco.name}
      </h2>
      <p class="mt-4 text-base leading-7 text-zinc-400">{distribution.canaco.blurb}</p>
      <div class="mt-6">
        <Button
          variant="primary"
          href={distribution.canaco.url}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 text-sm font-bold"
        >
          Ver el portal de socios
        </Button>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      {distribution.rails.map((r) => (
        <span class="rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-[12px] font-bold text-zinc-300">
          {r.name}
          <span class="ml-2 text-[10px] font-normal text-zinc-500">{r.blurb}</span>
        </span>
      ))}
    </div>
  </Container>
</Section>
