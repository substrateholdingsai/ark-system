---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Badge from '../ui/Badge.astro';
import { config } from '@/data/config';

const line = config.theme.default ?? 'legal';
const cloudflareItem = config.stack.find((item) => item.name.toLowerCase().includes('cloudflare'));
const otherItems = config.stack.filter((item) => item !== cloudflareItem);
---

<Section variant="surface" padding="lg" id="tech-stack" line={line} labelledBy="tech-stack-heading">
  <Container class="mb-12 text-center">
    <Badge class="mb-4">{config.stackSection.label}</Badge>
    <h2 id="tech-stack-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      {config.stackSection.headline}
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-text-muted">{config.stackSection.subheadline}</p>
  </Container>

  <Container>
    {cloudflareItem && (
      <div class="mb-8">
        <div class="relative overflow-hidden rounded-2xl border border-[#F38020]/20 bg-[#F38020]/[0.04] p-6 sm:p-8">
          <div
            class="pointer-events-none absolute -right-20 -top-20 h-48 w-48 rounded-full bg-[#F38020]/10 blur-[80px]"
            aria-hidden="true"
          ></div>

          <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-[#F38020]/30 bg-[#F38020]/10 text-sm font-black tracking-wider text-[#F38020]">
              CF
            </div>

            <div class="min-w-0 flex-1">
              <span class="rounded-full border border-[#F38020]/30 bg-[#F38020]/10 px-2 py-0.5 text-[10px] font-black uppercase tracking-widest text-[#F38020]">
                CIMIENTO
              </span>
              <h3 class="mt-2 text-lg font-semibold text-white">{cloudflareItem.name}</h3>
              <p class="mt-1 text-sm text-text-muted">{cloudflareItem.desc}</p>
            </div>

            <div class="grid shrink-0 grid-cols-3 gap-4 sm:gap-6">
              {config.hero.stats.map((stat) => (
                <div class="text-center">
                  <div class="text-xl font-black tracking-tight text-white">{stat.value}</div>
                  <div class="text-[10px] font-bold uppercase tracking-widest text-text-muted">
                    {stat.label}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    )}

    <div class="mb-4">
      <p class="text-[11px] font-bold uppercase tracking-widest text-text-muted">
        CAPAS SOBRE EL CIMIENTO
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {otherItems.map((item) => (
        <div class="group flex items-start gap-4 rounded-xl border border-white/[0.06] bg-white/[0.02] p-5 transition-all duration-300 ease-ark hover:border-ark-accent/30 hover:bg-white/[0.04]">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-ark-accent/10 text-[10px] font-black tracking-wider text-ark-accent transition-transform duration-300 ease-ark group-hover:scale-110">
            {item.name.slice(0, 3).toUpperCase()}
          </div>

          <div class="min-w-0 flex-1">
            <h3 class="truncate text-[14px] font-semibold text-white">{item.name}</h3>
            <p class="mt-1 line-clamp-2 text-[12px] leading-5 text-text-muted">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <p class="text-center text-xs text-text-muted">
        Cimiento: <span class="font-mono text-[#F38020]">Cloudflare Edge</span>
        <span class="mx-2 text-zinc-700">·</span>
        Arquitectura: <span class="font-mono">Astro + TypeScript</span>
        <span class="mx-2 text-zinc-700">·</span>
        Datos: <span class="font-mono">D1 + Vector</span>
      </p>
    </div>
  </Container>
</Section>
