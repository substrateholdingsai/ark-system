---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Badge from '../ui/Badge.astro';

const integrations = [
  { name: 'Stripe', category: 'Payments', color: '#635BFF' },
  { name: 'Mercado Pago', category: 'LATAM Payments', color: '#00B1EA' },
  { name: 'BTCPay Server', category: 'Bitcoin Lightning', color: '#F7931A' },
  { name: 'Cal.com', category: 'Scheduling', color: '#292929' },
  { name: 'Cloudflare Pages', category: 'Edge Hosting', color: '#F38020' },
  { name: 'Formspree', category: 'Forms', color: '#E51D9A' },
];
---

<Section variant="surface" padding="lg" id="tech-stack">
  <Container class="text-center mb-12">
    <Badge class="mb-4">Services Agnostic</Badge>
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">We don't lock you in.</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">
      Connect any payment gateway, scheduling tool, or form service. Ark is infrastructure, not a
      platform.
    </p>
  </Container>

  <Container>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {integrations.map((integration) => (
        <div class="ark-card group flex items-center gap-4 p-6 transition-all duration-300 ease-ark hover:border-white/[0.15]">
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl text-lg font-bold text-white transition-transform duration-300 ease-ark group-hover:scale-110"
            style={`background-color: ${integration.color}`}
          >
            {integration.name[0]}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-[15px] font-semibold text-white truncate">{integration.name}</h3>
            <p class="mt-0.5 text-[12px] text-zinc-500 uppercase tracking-wide">
              {integration.category}
            </p>
          </div>
          <svg
            class="h-5 w-5 shrink-0 text-zinc-600 transition-all duration-300 ease-ark group-hover:text-ark-accent group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      ))}
    </div>
  </Container>
</Section>
