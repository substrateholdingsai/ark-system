---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Badge from '../ui/Badge.astro';
import { config } from '@/data/config';
---

<Section variant="surface" padding="lg" id="tech-stack">
  <Container class="text-center mb-12">
    <Badge class="mb-4">{config.stackSection.label}</Badge>
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      {config.stackSection.headline}
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">{config.stackSection.subheadline}</p>
  </Container>

  <Container>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {config.stack.map((item) => (
        <div class="ark-card group flex items-center gap-4 p-6 transition-all duration-300 ease-ark hover:border-white/[0.15]">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-ark-accent/10 text-xs font-black tracking-wider text-ark-accent transition-transform duration-300 ease-ark group-hover:scale-110">
            {item.name.slice(0, 3).toUpperCase()}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-[15px] font-semibold text-white truncate">{item.name}</h3>
            <p class="mt-0.5 text-[12px] text-zinc-500">{item.desc}</p>
          </div>
          <svg
            class="h-5 w-5 shrink-0 text-zinc-600 transition-all duration-300 ease-ark group-hover:text-ark-accent group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      ))}
    </div>
  </Container>
</Section>
