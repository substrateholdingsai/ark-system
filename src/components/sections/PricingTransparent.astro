---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import Button from '../ui/Button.astro';
import { products, productPricing } from '@/data/config';

const nameById = Object.fromEntries(products.map((p) => [p.id, p.name]));
---

<Section id="pricing" variant="void" padding="lg">
  <Container>
    <div class="mb-10 max-w-[720px]">
      <div class="text-[11px] font-black tracking-widest text-zinc-500">PRECIOS TRANSPARENTES</div>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-white sm:text-4xl">
        Precios transparentes. Sin "contáctanos".
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {productPricing.map((p) => (
        <article class="flex flex-col rounded-[20px] border border-white/[0.06] bg-[#0A0A0B] p-6">
          <h3 class="text-base font-black text-white">{nameById[p.productId]}</h3>
          <div class="mt-3 text-2xl font-black tracking-tight text-ark-accent">{p.price}</div>
          <ul class="mt-4 space-y-1 text-[12px] text-zinc-400">
            {p.includes.map((i) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ark-accent"></span>
                <span>{i}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6">
            <Button
              variant="primary"
              href={p.cta.href}
              target={p.cta.external ? '_blank' : undefined}
              rel={p.cta.external ? 'noopener noreferrer' : undefined}
              class="h-10 w-full justify-center text-[13px] font-bold"
            >
              {p.cta.label}
            </Button>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-8 text-sm text-zinc-400">
      Sentinela y Hermes: suscripción por tenant / por reporte + suscripción. Sin "contact us for
      pricing".
    </p>
  </Container>
</Section>
