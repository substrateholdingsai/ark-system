---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { config } from '@/data/config';
---

<Section variant="default" padding="lg" id="portfolio">
  <Container class="text-center mb-12">
    <Badge class="mb-4">Our Work</Badge>
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Frictionless by design.
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">
      See how the Ark engine adapts to different industries while maintaining 100/100 performance.
    </p>
  </Container>

  <Container>
    <div class="grid gap-8 sm:grid-cols-2">
      {config.portfolio.map((project, index) => (
        <a href={project.url} target="_blank" rel="noopener noreferrer" class="group block">
          <Card class="overflow-hidden transition-transform duration-300 ease-ark group-hover:-translate-y-1">
            <div class="aspect-video w-full bg-surface-hover flex items-center justify-center border-b border-white/[0.08] overflow-hidden">
              <img
                src={project.image || `/assets/vector/portfolio-placeholder-${(index % 3) + 1}.svg`}
                alt={project.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>

            <div class="p-6">
              <h3 class="text-xl font-semibold text-white group-hover:text-ark-accent transition-colors">
                {project.name}
              </h3>
              <p class="mt-2 text-sm text-zinc-400">{project.description}</p>
              <div class="mt-4 flex items-center gap-2 text-sm font-medium text-ark-accent">
                View Live Site
                <svg
                  class="h-4 w-4 transition-transform duration-300 ease-ark group-hover:translate-x-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </div>
            </div>
          </Card>
        </a>
      ))}
    </div>
  </Container>
</Section>
