---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { config } from '@/data/config';

const line = config.theme.default ?? 'legal';

const featuredByLine = (['legal', 'commerce', 'lab'] as const).flatMap((lineId) => {
  const lineData = config.lines.find((entry) => entry.id === lineId);
  const item = config.portfolio.find(
    (entry) => entry.line === lineId && entry.available !== false && Boolean(entry.url),
  );

  return item?.url
    ? [
        {
          line: lineId,
          lineName: lineData?.name ?? 'Ark',
          lineTagline: lineData?.tagline ?? '',
          item,
          url: item.url,
        },
      ]
    : [];
});
---

<Section
  variant="default"
  padding="lg"
  id="portfolio-preview"
  line={line}
  labelledBy="portfolio-preview-heading"
>
  <Container class="mb-12 text-center">
    <Badge class="mb-4">PORTAFOLIO</Badge>
    <h2
      id="portfolio-preview-heading"
      class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
    >
      Tres líneas, un cimiento.
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">
      Ark Legal es nuestra bandera. Ark Commerce es nuestro flujo. Ark Lab es nuestro I+D. Todos
      corren sobre el mismo motor: Cloudflare Edge.
    </p>
  </Container>

  <Container>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {featuredByLine.map(({ line: lineId, lineName, lineTagline, item, url }) => (
        <a
          href={url}
          target={url.startsWith('http') ? '_blank' : undefined}
          rel={url.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="group block"
          data-theme={lineId}
        >
          <Card
            padding="none"
            class="overflow-hidden transition-transform duration-300 ease-ark group-hover:-translate-y-1"
          >
            <div class="relative aspect-video w-full overflow-hidden border-b border-white/[0.08] bg-surface-hover">
              <img
                src={item.image}
                alt={item.name}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute left-3 top-3">
                <span class="rounded-full border border-white/40 bg-black/70 px-2.5 py-1 text-[10px] font-black uppercase tracking-widest text-white backdrop-blur">
                  {lineName}
                </span>
              </div>
            </div>

            <div class="p-6">
              <h3 class="text-xl font-semibold text-text-primary transition-colors group-hover:text-ark-accent">
                {item.name}
              </h3>
              <p class="mt-1 text-[11px] font-bold uppercase tracking-widest text-text-muted">
                {lineTagline}
              </p>
              <p class="mt-3 line-clamp-2 text-sm text-text-muted">{item.description}</p>

              <div class="mt-5 flex items-center justify-between gap-3">
                <span class="inline-flex items-center gap-2 text-sm font-medium text-ark-accent">
                  {lineId === 'legal' ? 'Ver análisis' : 'Ver caso'}
                  <svg
                    class="h-4 w-4 transition-transform duration-300 ease-ark group-hover:translate-x-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </span>
                <span class="flex items-center gap-1.5 text-[10px] text-text-muted">
                  <span class="h-1 w-1 rounded-full bg-[#F38020]"></span>
                  <span class="font-mono">Edge</span>
                </span>
              </div>
            </div>
          </Card>
        </a>
      ))}
    </div>

    <div class="mt-12 flex justify-center">
      <Button
        variant="secondary"
        href="/portfolio"
        class="border-white/10 bg-white/[0.06] px-6 text-sm font-bold text-white hover:bg-white/[0.10]"
      >
        Ver portafolio completo →
      </Button>
    </div>
  </Container>
</Section>
