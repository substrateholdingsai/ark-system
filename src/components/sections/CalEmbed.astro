---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Badge from '../ui/Badge.astro';
import { buildCalUrl } from '../../utils/helpers';

export interface Props {
  tier?: string;
  name?: string;
  email?: string;
  notes?: string;
  title?: string;
  description?: string;
}

const {
  tier,
  name,
  email,
  notes,
  title = 'Agenda una asesoría',
  description = 'Elige un horario para conversar sobre tu proyecto.',
} = Astro.props;

const src = buildCalUrl({ tier, name, email, notes });
---

<Section variant="default" padding="lg" id="booking">
  <Container class="text-center mb-8">
    <Badge class="mb-4">AGENDA</Badge>
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">{description}</p>
  </Container>

  <Container size="prose">
    <div class="ark-card overflow-hidden">
      <div class="relative aspect-[4/3] sm:aspect-[16/10] w-full">
        <iframe
          src={src}
          class="absolute inset-0 h-full w-full border-0"
          loading="lazy"
          title={`Agenda de Cal.com: ${title}`}
          allow="payment"
        ></iframe>
      </div>
    </div>
  </Container>
</Section>

<script is:inline>
  (function () {
    const script = document.createElement('script');
    script.src = 'https://assets.cal.com/embed/index.js';
    script.async = true;
    document.head.appendChild(script);
  })();
</script>
