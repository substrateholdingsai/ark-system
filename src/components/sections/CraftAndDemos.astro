---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import Button from '../ui/Button.astro';
import { craftAndDemos } from '@/data/config';
---

<Section variant="void" padding="lg">
  <Container>
    <div class="mb-10 max-w-[720px]">
      <div class="text-[11px] font-black tracking-widest text-zinc-500">CRAFT & DEMOS</div>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-white sm:text-4xl">
        {craftAndDemos.title}
      </h2>
      <p class="mt-4 text-base leading-7 text-zinc-400">{craftAndDemos.intro}</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {craftAndDemos.items.map((item) => (
        <article class="flex flex-col overflow-hidden rounded-[20px] border border-white/[0.06] bg-[#0A0A0B]">
          <div class="relative aspect-[16/10] overflow-hidden bg-zinc-900">
            <img
              src={item.image}
              alt={item.name}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="text-base font-black text-white">{item.name}</h3>
            <p class="mt-2 line-clamp-3 text-[12px] leading-5 text-zinc-400">{item.description}</p>
            <div class="mt-4">
              {item.url ? (
                <Button
                  variant="ghost"
                  href={item.url}
                  target={item.url.startsWith('http') ? '_blank' : undefined}
                  rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="h-9 border-white/10 bg-white/[0.06] px-3 text-[12px] font-bold text-white hover:bg-white/[0.1]"
                >
                  Ver demo
                </Button>
              ) : (
                <span class="text-[11px] text-zinc-500">Sin demo interactivo</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10">
      <Button
        variant="ghost"
        href="/products"
        class="border-white/10 bg-white/[0.06] px-5 text-white hover:bg-white/[0.1]"
      >
        Ver productos →
      </Button>
    </div>
  </Container>
</Section>
