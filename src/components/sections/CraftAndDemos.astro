---
import { craftAndDemos } from '@/data/config';
---

<section id="demos" class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-14 max-w-3xl">
      <div class="mono inline-block rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-eterea-blue">
        PORTAFOLIO & APLICACIONES EN VIVO
      </div>
      <h2 class="instrument mt-3 text-4xl text-eterea-text sm:text-5xl lg:text-6xl">
        {craftAndDemos.title}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-eterea-muted sm:text-lg">
        {craftAndDemos.intro}
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {craftAndDemos.items.map((item) => (
        <article class="group flex flex-col overflow-hidden rounded-3xl border border-[#E6EEFF] bg-[#FAFCFF] shadow-sm transition-all hover:border-blue-300 hover:shadow-eterea-card">
          <div class="relative aspect-[16/10] overflow-hidden bg-slate-100 border-b border-slate-100">
            <img
              src={item.image}
              alt={item.name}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-eterea-blue transition-colors">
                {item.name}
              </h3>
              <p class="mt-2 line-clamp-3 text-xs leading-relaxed text-slate-600">
                {item.description}
              </p>
            </div>
            
            <div class="mt-6 border-t border-slate-100 pt-4">
              {item.url ? (
                <a
                  href={item.url}
                  target={item.url.startsWith('http') ? '_blank' : undefined}
                  rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-eterea-blue hover:text-blue-700"
                >
                  Explorar demo interactivo {item.url.startsWith('http') ? '↗' : '→'}
                </a>
              ) : (
                <span class="mono text-xs text-slate-400">Demo privado / bajo NDA</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/products"
        class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-6 py-3.5 text-xs font-semibold text-white transition-colors hover:bg-slate-800"
      >
        Ver catálogo completo de productos
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
