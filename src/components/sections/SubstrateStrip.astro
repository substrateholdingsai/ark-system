---
import { platform } from '@/data/config';
---

<section id="motor-operativo" class="border-b border-eterea-border bg-[#F5F8FF] py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-12 max-w-3xl">
      <div class="mono inline-block rounded-md bg-blue-100/60 px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-eterea-blue">
        INFRAESTRUCTURA COMPARTIDA
      </div>
      <h2 class="instrument mt-3 text-4xl text-eterea-text sm:text-5xl">
        Un solo motor operativo. <span class="italic text-eterea-blue">Siete productos integrados.</span>
      </h2>
      <p class="mt-4 text-base leading-relaxed text-eterea-muted sm:text-lg">
        En lugar de construir silos aislados, cada producto de la plataforma Ark se conecta a los mismos rieles: una sola base de clientes, auditoría criptográfica SHA-256 inviolable y pagos unificados con Stripe Connect.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {platform.substrate.map((s, idx) => (
        <div class="rounded-2xl border border-[#DCE7FF] bg-white p-6 shadow-sm transition-all hover:border-blue-300 hover:shadow-md">
          <div class="flex items-center justify-between">
            <span class="mono rounded bg-blue-50 px-2 py-0.5 text-xs font-bold text-eterea-blue">
              0{idx + 1}
            </span>
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          </div>
          <h3 class="mt-4 text-lg font-bold text-slate-900">{s.label}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.detail}</p>
        </div>
      ))}
    </div>

    <!-- Commercial advantage pill -->
    <div class="mt-10 rounded-2xl border border-blue-200 bg-white p-6 shadow-sm">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h4 class="text-base font-bold text-slate-900">¿Qué significa esto para tu negocio?</h4>
          <p class="mt-1 text-sm text-slate-600">
            Un cliente que entra por facturación en <strong>Ark Ledger</strong> ya tiene su RFC validado y buzón listo para recibir llamadas automáticas de cobro en <strong>Ark Angel</strong> o una tienda en <strong>Ark Commerce</strong> sin configuraciones duplicadas ni migraciones.
          </p>
        </div>
        <a
          href="/architecture"
          class="shrink-0 rounded-xl bg-slate-900 px-5 py-3 text-xs font-semibold text-white transition-colors hover:bg-slate-800"
        >
          Ver arquitectura técnica →
        </a>
      </div>
    </div>
  </div>
</section>
