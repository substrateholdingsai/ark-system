---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Card from '../ui/Card.astro';
import { config } from '@/data/config';

const line = config.theme.default ?? 'legal';
---

<Section variant="default" padding="lg" id="value-props" line={line} labelledBy="value-props-heading">
  <Container class="text-center mb-12">
    <h2 id="value-props-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Por qué Ark
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">
      Tres pilares que definen cada entrega.
    </p>
  </Container>

  <Container>
    <div class="grid gap-6 sm:grid-cols-3">
      <Card class="p-6 text-center hover:border-ark-accent/30 transition-colors duration-300">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-ark-accent/30 bg-ark-accent/10 text-ark-accent mb-4">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white">Seguridad</h3>
        <p class="mt-2 text-sm text-zinc-400">Cumplimiento normativo, encriptación edge y auditoría inmutable.</p>
      </Card>

      <Card class="p-6 text-center hover:border-ark-accent/30 transition-colors duration-300">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-ark-accent/30 bg-ark-accent/10 text-ark-accent mb-4">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white">Velocidad</h3>
        <p class="mt-2 text-sm text-zinc-400">Despliegue en segundos, latencia &lt;40ms global, sin cold-starts.</p>
      </Card>

      <Card class="p-6 text-center hover:border-ark-accent/30 transition-colors duration-300">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-ark-accent/30 bg-ark-accent/10 text-ark-accent mb-4">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white">Cumplimiento</h3>
        <p class="mt-2 text-sm text-zinc-400">Listo para SAT, PLD, GDPR y normativas sectoriales desde el día 1.</p>
      </Card>
    </div>
  </Container>
</Section>