---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { config } from '@/data/config';
---

<Section variant="surface" padding="lg" id="pricing">
  <Container class="text-center mb-12">
    <Badge class="mb-4">Transparent Pricing</Badge>
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Build once. Scale infinitely.
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">
      No hidden fees, no monthly platform taxes. Just pure, edge-native infrastructure.
    </p>
  </Container>

  <Container>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {config.pricing.map((tier, index) => {
        const isRecommended = tier.tier === 'Scale' || index === 1;
        return (
          <Card
            class={`flex flex-col p-8 ${isRecommended ? 'border-ark-accent/30 shadow-ark-glow' : ''}`}
          >
            {isRecommended && (
              <Badge variant="default" class="absolute -top-3 left-1/2 -translate-x-1/2">
                Most Popular
              </Badge>
            )}

            <h3 class="text-xl font-semibold text-white">{tier.tier}</h3>
            <div class="mt-4 flex items-baseline gap-1">
              <span class="text-4xl font-bold tracking-tight text-white">
                {tier.currency === 'USD' ? '$' : ''}
                {tier.price}
              </span>
              {(tier as any).period && <span class="text-sm text-zinc-400">/{(tier as any).period}</span>}
            </div>

            <ul class="mt-8 space-y-4 flex-1">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-zinc-300">
                  <svg
                    class="h-5 w-5 flex-shrink-0 text-ark-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            <Button
              variant={isRecommended ? 'primary' : 'secondary'}
              href={tier.ctaLink}
              class="mt-8 w-full"
            >
              Get Started
            </Button>
          </Card>
        );
      })}
    </div>
  </Container>
</Section>
