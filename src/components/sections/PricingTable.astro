---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { config } from '@/data/config';

const formatAmount = (amount: number, currency: string) =>
  new Intl.NumberFormat(config.locale.replace('_', '-'), {
    style: 'currency',
    currency,
    maximumFractionDigits: 0,
  }).format(amount);
---

<Section variant="surface" padding="lg" id="pricing">
  <Container class="text-center mb-12">
    <Badge class="mb-4">{config.pricing.label}</Badge>
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      {config.pricing.headline}
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">{config.pricing.subheadline}</p>
  </Container>

  <Container>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {config.pricing.plans.map((plan) => {
        const isRecommended = plan.label.includes('RECOMENDADO');
        const features = plan.includes ?? plan.bullets ?? [];
        const priceCurrency = plan.currency ?? 'USD';
        return (
          <Card
            class={`flex flex-col p-8 ${isRecommended ? 'border-ark-accent/30 shadow-ark-glow' : ''} ${!plan.available ? 'opacity-75' : ''}`}
          >
            {(plan.badge || plan.label) && (
              <Badge variant="default" class="absolute -top-3 left-1/2 -translate-x-1/2">
                {plan.badge ?? plan.label}
              </Badge>
            )}

            <p class="text-xs font-semibold uppercase tracking-widest text-zinc-400">
              {plan.label}
            </p>
            <h3 class="mt-2 text-xl font-semibold text-white">{plan.name}</h3>
            <p class="mt-3 min-h-12 text-sm text-zinc-400">{plan.summary}</p>

            <div class="mt-4 flex items-baseline gap-1">
              {plan.price !== undefined && (
                <>
                  <span class="text-4xl font-bold tracking-tight text-white">
                    {formatAmount(plan.price, priceCurrency)}
                  </span>
                  {plan.billing && (
                    <span class="text-sm text-zinc-400">
                      {plan.billing === 'one_time' ? 'una vez' : `/${plan.billing}`}
                    </span>
                  )}
                </>
              )}
              {plan.monthly !== undefined && (
                <>
                  <span class="text-4xl font-bold tracking-tight text-white">
                    {formatAmount(plan.monthly, priceCurrency)}
                  </span>
                  <span class="text-sm text-zinc-400">/mes</span>
                </>
              )}
            </div>

            {(plan.subprice || plan.total || plan.total36Months) && (
              <p class="mt-3 text-sm text-zinc-400">
                {plan.subprice ?? plan.total36Months ?? plan.total}
              </p>
            )}

            {plan.contractMonths && (
              <p class="mt-2 text-xs text-zinc-500">{plan.contractMonths} meses de contrato</p>
            )}
            {plan.setup !== undefined && (
              <p class="mt-2 text-sm text-zinc-400">
                Setup: {formatAmount(plan.setup, priceCurrency)}
              </p>
            )}
            {plan.residual !== undefined && (
              <p class="mt-2 text-sm text-zinc-400">
                Residual: {formatAmount(plan.residual, priceCurrency)}
              </p>
            )}

            <ul class="mt-8 flex-1 space-y-4">
              {features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-zinc-300">
                  <svg
                    class="h-5 w-5 flex-shrink-0 text-ark-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            {plan.excludes && (
              <details class="mt-5 text-sm text-zinc-400">
                <summary class="cursor-pointer">{`No incluye (${plan.excludes.length})`}</summary>
                <ul class="mt-3 list-inside list-disc space-y-1">
                  {plan.excludes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </details>
            )}

            {plan.cta && plan.available && (
              <Button
                variant={plan.cta.variant === 'ghost' ? 'ghost' : plan.cta.variant}
                href={plan.cta.href}
                target={plan.cta.external ? '_blank' : undefined}
                rel={plan.cta.external ? 'noopener noreferrer' : undefined}
                class="mt-8 w-full"
              >
                {plan.cta.label}
              </Button>
            )}
            {plan.ctaBadge && (
              <p class="mt-3 text-center text-xs font-medium text-ark-accent">{plan.ctaBadge}</p>
            )}
            {plan.microcopy && (
              <p class="mt-3 text-center text-xs text-zinc-500">{plan.microcopy}</p>
            )}
          </Card>
        );
      })}
    </div>
  </Container>

  <Container class="mt-16">
    <Card class="p-8 sm:p-10">
      <Badge class="mb-4">{config.pricing.fiscal.badge}</Badge>
      <h3 class="text-2xl font-bold text-white">{config.pricing.fiscal.headline}</h3>
      <p class="mt-4 text-sm text-zinc-300">{config.pricing.fiscal.body}</p>
      <ul class="mt-5 flex flex-wrap gap-3">
        {config.pricing.fiscal.badges.map((badge) => (
          <li class="rounded-full border border-white/10 px-3 py-1 text-xs text-zinc-300">
            {badge}
          </li>
        ))}
      </ul>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {config.pricing.fiscal.comparison.map((item) => (
          <div class="rounded-xl border border-white/10 p-4">
            <h4 class="font-semibold text-white">{item.model}</h4>
            <p class="mt-2 text-sm text-zinc-400">{item.effect}</p>
            <p class="mt-1 text-sm text-zinc-300">{item.cashflow}</p>
          </div>
        ))}
      </div>
      <p class="mt-5 text-xs text-zinc-500">{config.pricing.fiscal.disclaimer}</p>
    </Card>
  </Container>

  <Container class="mt-12">
    <h3 class="text-xl font-semibold text-white">Métodos de pago</h3>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {config.pricing.paymentMethods.map((method) => (
        <Card class="p-5">
          <div class="flex items-center justify-between gap-3">
            <h4 class="font-semibold text-white">{method.title}</h4>
            <span class="text-xs font-mono text-ark-accent">{method.code}</span>
          </div>
          {method.badge && <p class="mt-2 text-xs text-ark-accent">{method.badge}</p>}
          <p class="mt-3 text-sm text-zinc-300">{method.method}</p>
          <p class="mt-2 text-xs text-zinc-500">{method.detail}</p>
        </Card>
      ))}
    </div>
    {config.pricing.btcCopy && <p class="mt-6 text-sm text-zinc-400">{config.pricing.btcCopy}</p>}
  </Container>
</Section>
