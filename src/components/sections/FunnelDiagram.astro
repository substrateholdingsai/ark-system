---
import Container from '../layout/Container.astro';
import { funnel } from '@/data/config';

const nodeMap = Object.fromEntries(funnel.nodes.map((n) => [n.id, n]));
---

<section id="funnel" class="border-b border-white/[0.06] bg-void py-20 sm:py-28">
  <Container>
    <div class="mb-10 max-w-[720px]">
      <div class="text-[11px] font-black tracking-widest text-zinc-500">EL EMBUDO FEDERADO</div>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-white sm:text-4xl">
        Siete productos. Un sustrato. Un embudo.
      </h2>
      <p class="mt-4 text-base leading-7 text-zinc-400">
        Cada lead que Sales califica se entrega con contrato versionado, reintentos por outbox e
        idempotencia por <code class="text-ark-accent">lead_id</code>. El costo de adquirir un
        cliente para Ledger, Angel o Commerce tiende a cero una vez que Sales lo ha tocado.
      </p>
    </div>

    <div class="funnel-wrap opacity-0 transition-opacity duration-700" data-funnel>
      <svg
        viewBox="0 0 100 100"
        class="w-full max-w-4xl mx-auto"
        role="img"
        aria-label="Embudo federado ARK"
      >
        {funnel.edges.map((e) => {
          const a = nodeMap[e.from];
          const b = nodeMap[e.to];
          const mx = (a.x + b.x) / 2;
          const my = (a.y + b.y) / 2;
          return (
            <g>
              <line
                x1={a.x}
                y1={a.y}
                x2={b.x}
                y2={b.y}
                stroke="rgba(255,255,255,0.25)"
                stroke-width="0.6"
                class="funnel-edge"
              />
              {e.label && (
                <text
                  x={mx}
                  y={my - 1.5}
                  text-anchor="middle"
                  font-size="2.2"
                  fill="#F38020"
                  font-weight="700"
                >
                  {e.label}
                </text>
              )}
            </g>
          );
        })}
        {funnel.nodes.map((n) => (
          <g class="funnel-node">
            <circle
              cx={n.x}
              cy={n.y}
              r="6"
              fill="#0A0A0B"
              stroke="rgba(243,128,32,0.6)"
              stroke-width="0.6"
            />
            <text
              x={n.x}
              y={n.y + 0.8}
              text-anchor="middle"
              font-size="2.4"
              fill="#fff"
              font-weight="700"
            >
              {n.label}
            </text>
          </g>
        ))}
      </svg>
    </div>
  </Container>
</section>

<script>
  const wrap = document.querySelector('[data-funnel]');
  if (wrap) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.remove('opacity-0');
            e.target.classList.add('opacity-100');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    io.observe(wrap);
  }
</script>
