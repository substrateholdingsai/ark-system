---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import { platform } from '@/data/config';
---

<Section variant="surface" padding="lg">
  <Container>
    <div class="mb-10 max-w-[720px]">
      <div class="text-[11px] font-black tracking-widest text-zinc-500">HONESTIDAD</div>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-white sm:text-4xl">
        Lo que todavía estamos probando.
      </h2>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {platform.disclosures.map((d) => (
        <article class="rounded-[16px] border border-white/[0.06] bg-[#0A0A0B] p-5">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-black text-white">{d.title}</h3>
            <span class="rounded-full border border-white/10 bg-white/[0.03] px-2 py-0.5 text-[9px] font-bold tracking-widest text-zinc-400">
              {d.status}
            </span>
          </div>
          <p class="mt-3 text-[12px] leading-5 text-zinc-400">{d.detail}</p>
        </article>
      ))}
    </div>

    <p class="mt-8 max-w-[720px] text-sm leading-6 text-zinc-400">
      Publicamos esto porque es exactamente lo que un equipo de debida diligencia técnica preguntará
      primero.
    </p>
  </Container>
</Section>
