---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import Button from '../ui/Button.astro';
import { products } from '@/data/config';

const primary = products.filter((p) => p.size === 'primary');
const compact = products.filter((p) => p.size === 'compact');
---

<Section id="product-matrix" variant="surface" padding="lg">
  <Container>
    <div class="mb-10 max-w-[720px]">
      <div class="text-[11px] font-black tracking-widest text-zinc-500">MATRIZ DE PRODUCTOS</div>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-white sm:text-4xl">
        Siete productos. Un sustrato. Un embudo.
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {primary.map((p) => (
        <article class="flex flex-col rounded-[20px] border border-white/[0.06] bg-[#0A0A0B] p-6 transition-all hover:border-ark-accent/30">
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-xl font-black text-white">{p.name}</h3>
            {p.domain && (
              <a
                href={`https://${p.domain}`}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 rounded-full border border-white/10 bg-white/[0.03] px-2.5 py-1 text-[10px] font-mono text-zinc-300 hover:text-white"
              >
                {p.domain}
              </a>
            )}
          </div>
          <p class="mt-3 text-sm leading-6 text-zinc-400">{p.tagline}</p>
          <dl class="mt-4 space-y-1 text-[12px]">
            <div class="flex gap-2">
              <dt class="font-bold text-zinc-500">TAM</dt>
              <dd class="text-zinc-300">{p.tam}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="font-bold text-zinc-500">Revenue</dt>
              <dd class="text-zinc-300">{p.revenue}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="font-bold text-zinc-500">Maturity</dt>
              <dd class="text-zinc-300">{p.maturity}</dd>
            </div>
          </dl>
          {p.absorbedInto && (
            <span class="mt-3 inline-flex w-fit rounded-full border border-ark-accent/30 bg-ark-accent/[0.08] px-2.5 py-1 text-[10px] font-black tracking-widest text-ark-accent">
              Absorbido en {p.absorbedInto.join(' + ')}
            </span>
          )}
          <div class="mt-6 flex flex-wrap gap-3">
            <Button variant="primary" href={p.ctaProduct} class="h-10 px-4 text-[13px] font-bold">
              Ver producto
            </Button>
            {p.ctaDomain && (
              <Button
                variant="ghost"
                href={p.ctaDomain}
                target="_blank"
                rel="noopener noreferrer"
                class="h-10 border-white/10 bg-white/[0.06] px-4 text-[13px] font-bold text-white hover:bg-white/[0.1]"
              >
                Ir al dominio
              </Button>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {compact.map((p) => (
        <article class="flex flex-col rounded-[16px] border border-white/[0.06] bg-[#0A0A0B] p-4">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-base font-black text-white">{p.name}</h3>
            {p.absorbedInto && (
              <span class="rounded-full border border-ark-accent/30 bg-ark-accent/[0.08] px-2 py-0.5 text-[9px] font-black tracking-widest text-ark-accent">
                Absorbido
              </span>
            )}
          </div>
          <p class="mt-2 text-[12px] leading-5 text-zinc-400">{p.tagline}</p>
          <a href={p.ctaProduct} class="mt-3 text-[12px] font-bold text-ark-accent hover:underline">
            Ver producto →
          </a>
        </article>
      ))}
    </div>
  </Container>
</Section>
