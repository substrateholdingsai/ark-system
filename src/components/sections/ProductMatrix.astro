---
import { products } from '@/data/config';

const primary = products.filter((p) => p.size === 'primary');
const compact = products.filter((p) => p.size === 'compact');
---

<section id="product-matrix" class="border-b border-eterea-border bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-12 max-w-3xl">
      <div class="mono inline-block rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-eterea-blue">
        MATRIZ DE PRODUCTOS EN PRODUCCIÓN
      </div>
      <h2 class="instrument mt-3 text-4xl text-eterea-text sm:text-5xl lg:text-6xl">
        Siete productos. <span class="italic text-eterea-blue">Un solo motor operativo.</span>
      </h2>
      <p class="mt-4 text-base leading-relaxed text-eterea-muted sm:text-lg">
        Cada producto resuelve un cuello de botella crítico en la operación de despachos, clínicas y empresas de servicios profesionales en México y EE. UU. Todos comparten identidad federada, trazabilidad criptográfica y rieles de cobro.
      </p>
    </div>

    <!-- 4 Primary Hero Products -->
    <div class="grid gap-6 md:grid-cols-2">
      {primary.map((p) => (
        <article class="flex flex-col justify-between rounded-3xl border border-[#E6EEFF] bg-gradient-to-br from-[#FAFCFF] to-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-eterea-card">
          <div>
            <div class="flex items-start justify-between gap-3">
              <div>
                <span class="mono text-xs font-semibold text-eterea-blue">{p.id.toUpperCase()}</span>
                <h3 class="mt-1 text-2xl font-bold tracking-tight text-slate-900">{p.name}</h3>
              </div>
              {p.domain && (
                <a
                  href={`https://${p.domain}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 rounded-lg border border-slate-200 bg-white px-3 py-1 mono text-xs font-medium text-slate-700 transition-colors hover:border-blue-400 hover:text-eterea-blue"
                >
                  {p.domain} ↗
                </a>
              )}
            </div>

            <p class="mt-3 text-sm leading-relaxed text-slate-600">{p.tagline}</p>

            <div class="mt-6 grid grid-cols-3 gap-2 rounded-2xl border border-slate-100 bg-[#F5F8FF] p-3 text-xs">
              <div>
                <span class="block mono text-[10px] uppercase text-slate-400">TAM</span>
                <strong class="font-medium text-slate-800">{p.tam}</strong>
              </div>
              <div>
                <span class="block mono text-[10px] uppercase text-slate-400">Modelo</span>
                <strong class="font-medium text-slate-800">{p.revenue}</strong>
              </div>
              <div>
                <span class="block mono text-[10px] uppercase text-slate-400">Madurez</span>
                <strong class="font-medium text-slate-800">{p.maturity}</strong>
              </div>
            </div>

            {p.absorbedInto && (
              <div class="mt-4 flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
                <span class="mono text-xs text-blue-600">
                  Capacidad absorbida en {p.absorbedInto.join(' + ')}
                </span>
              </div>
            )}
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={p.ctaProduct}
              class="inline-flex items-center gap-1.5 rounded-xl bg-eterea-blue px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-blue-700"
            >
              Ficha del producto
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            {p.ctaDomain && (
              <a
                href={p.ctaDomain}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-medium text-slate-700 transition-all hover:border-slate-300 hover:bg-slate-50"
              >
                Abrir aplicación web ↗
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- 3 Satellites / Modules in Compact Cards -->
    <div class="mt-8">
      <div class="mb-4 flex items-center gap-2">
        <span class="mono text-xs font-medium uppercase tracking-wider text-slate-500">Módulos Especializados & Verticales</span>
        <div class="h-px flex-1 bg-slate-100"></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {compact.map((p) => (
          <article class="flex flex-col justify-between rounded-2xl border border-slate-200/80 bg-slate-50/70 p-5 transition-all duration-200 hover:border-blue-300 hover:bg-white hover:shadow-sm">
            <div>
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-base font-bold text-slate-900">{p.name}</h3>
                {p.domain && (
                  <span class="mono text-[11px] text-slate-400">{p.domain}</span>
                )}
              </div>
              <p class="mt-2 text-xs leading-relaxed text-slate-600">{p.tagline}</p>
            </div>
            <div class="mt-4 flex items-center justify-between border-t border-slate-200/60 pt-3">
              <span class="mono text-[11px] text-blue-600">{p.revenue}</span>
              <a
                href={p.ctaProduct}
                class="inline-flex items-center gap-1 text-xs font-semibold text-slate-800 transition-colors hover:text-eterea-blue"
              >
                Ver módulo →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
