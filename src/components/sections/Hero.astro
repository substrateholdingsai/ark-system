---
import Button from '../ui/Button.astro';
import Container from '../layout/Container.astro';
import { config } from '@/data/config';

const headlineWords = config.hero.headline.trim().split(/\s+/);
const headlineLead = headlineWords.slice(0, -2).join(' ');
const headlineAccent = headlineWords.slice(-2).join(' ');
const line = config.theme.default ?? 'legal';
const lineLabel = line === 'legal' ? 'ARK LEGAL' : line === 'commerce' ? 'ARK COMMERCE' : 'ARK LAB';
---

<section
  id="que-es"
  data-theme={line}
  class="relative isolate overflow-visible border-b border-white/[0.06] bg-void py-20 sm:py-28 lg:py-32"
>
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_80%_55%_at_50%_0%,#000_45%,transparent_100%)]"></div>
    <img
      src="/assets/vector/glow-accent.svg"
      alt=""
      class="absolute left-1/2 top-[-12rem] w-[min(900px,120vw)] -translate-x-1/2 opacity-35"
    />
    <img
      src="/assets/vector/grid-accent.svg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-[0.08]"
    />
    <div class="absolute -right-40 top-1/3 h-96 w-96 rounded-full bg-ark-accent/10 blur-[120px]"></div>
  </div>

  <Container>
    <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-10">
      <!-- Left content -->
      <div class="text-left">
        <div class="inline-flex max-w-full flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-[11px] font-bold tracking-widest text-zinc-300 backdrop-blur">
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
          {lineLabel} <span class="text-zinc-600">•</span> EDGE LIVE
          <span class="text-zinc-600">•</span> INFRAESTRUCTURA PROFESIONAL
        </div>

        <h1 class="mt-6 max-w-full break-words text-[36px] font-black leading-[0.98] tracking-[-0.035em] text-white sm:text-[52px] lg:text-[64px]">
          {headlineLead} <span class="text-ark-accent">{headlineAccent}</span>
        </h1>

        <p class="mt-5 max-w-full text-base leading-7 text-zinc-400 sm:max-w-[52ch] sm:text-lg">
          {config.hero.subheadline}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button
            variant={
              config.hero.primaryCta.variant === 'ghost' ? 'ghost' : config.hero.primaryCta.variant
            }
            href={config.hero.primaryCta.href}
            target={config.hero.primaryCta.external ? '_blank' : undefined}
            rel={config.hero.primaryCta.external ? 'noopener noreferrer' : undefined}
            class="px-6 text-sm font-bold"
          >
            {config.hero.primaryCta.label}
          </Button>
          {config.hero.secondaryCta && (
            <Button
              variant={
                config.hero.secondaryCta.variant === 'ghost'
                  ? 'ghost'
                  : config.hero.secondaryCta.variant
              }
              href={config.hero.secondaryCta.href}
              target={config.hero.secondaryCta.external ? '_blank' : undefined}
              rel={config.hero.secondaryCta.external ? 'noopener noreferrer' : undefined}
              class="border-white/10 bg-white/[0.06] px-5 text-white hover:bg-white/[0.1]"
            >
              {config.hero.secondaryCta.label}
            </Button>
          )}
        </div>

        {config.hero.microcopy && (
          <p class="mt-4 inline-flex max-w-full items-start gap-2 text-xs text-zinc-500">
            <span
              class="grid h-3.5 w-3.5 place-items-center rounded-full border border-zinc-700 text-[9px] text-ark-accent"
              aria-hidden="true"
            >
              ✓
            </span>
            {config.hero.microcopy}
          </p>
        )}

        <dl class="mt-10 grid w-full max-w-[440px] grid-cols-3 gap-3 border-t border-white/[0.06] pt-6 sm:gap-6">
          {config.hero.stats.map((stat) => (
            <div>
              <dd class="break-words text-2xl font-black tracking-tight text-white sm:text-[28px]">
                {stat.value}
              </dd>
              <dt class="mt-1 break-words text-[9px] font-bold uppercase tracking-[0.08em] text-zinc-500 sm:text-[10px] sm:tracking-widest">
                {stat.label}
              </dt>
            </div>
          ))}
        </dl>
      </div>

      <!-- Right side: Terminal + Video -->
      <div class="relative mx-auto w-full min-w-0 max-w-xl lg:mx-0 lg:max-w-none">
        <div class="overflow-hidden rounded-[20px] border border-white/[0.08] bg-[#0A0A0B] shadow-[0_20px_60px_rgba(0,0,0,0.5),inset_0_1px_0_0_rgba(255,255,255,0.06)]">
          
          <!-- Terminal header -->
          <div class="flex h-11 items-center justify-between gap-3 border-b border-white/[0.06] bg-white/[0.02] px-4">
            <div class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
              <span class="h-2.5 w-2.5 rounded-full bg-red-500/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-green-500/80"></span>
            </div>
            <span class="truncate font-mono text-[10px] text-zinc-500">
              ark-systems · demo en vivo
            </span>
            <span class="shrink-0 rounded-full border border-ark-accent/25 bg-ark-accent/10 px-2 py-0.5 text-[9px] font-bold tracking-widest text-ark-accent">
              VIDEO
            </span>
          </div>

          <!-- Video area -->
          <div class="relative aspect-[4/5] w-full bg-black sm:aspect-[5/4]">
            <!-- Thumbnail + custom play button -->
            <button
              id="hero-video-trigger"
              type="button"
              class="group absolute inset-0 flex items-center justify-center"
              aria-label="Reproducir video de Ark Systems"
            >
              <img
                src="https://i.ytimg.com/vi/6eptZbYvpMU/maxresdefault.jpg"
                alt="Demo Ark Systems — Infraestructura Web en el Edge"
                class="absolute inset-0 h-full w-full object-cover opacity-80 transition duration-300 group-hover:opacity-90"
                loading="lazy"
                width="1280"
                height="720"
              />
              <!-- Gradient overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/20"></div>
              
              <!-- Play button -->
              <div class="relative z-10 flex h-16 w-16 items-center justify-center rounded-full border border-white/20 bg-black/60 shadow-2xl backdrop-blur-md transition-all duration-300 group-hover:scale-105 group-hover:border-ark-accent/40 group-hover:bg-ark-accent/90">
                <svg class="ml-1 h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </button>

            <!-- YouTube iframe (hidden until click) -->
            <iframe
              id="hero-video-iframe"
              class="absolute inset-0 hidden h-full w-full"
              src=""
              title="Ark Systems — Infraestructura Web en el Edge"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>

        <!-- Floating badges -->
        <div class="absolute -right-3 top-16 hidden items-center gap-2 rounded-full bg-white px-3 py-1.5 text-[10px] font-black text-black shadow-xl sm:flex lg:-right-4">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          DEMO EN VIVO
        </div>
        <div class="absolute -left-3 bottom-12 hidden items-center gap-2 rounded-full bg-ark-accent px-3 py-1.5 text-[10px] font-black text-ark-contrast shadow-xl sm:flex lg:-left-5">
          {lineLabel}
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  const trigger = document.getElementById('hero-video-trigger');
  const iframe = document.getElementById('hero-video-iframe') as HTMLIFrameElement | null;

  if (trigger && iframe) {
    trigger.addEventListener('click', () => {
      iframe.src =
        'https://www.youtube.com/embed/6eptZbYvpMU?autoplay=1&rel=0&modestbranding=1&playsinline=1';
      iframe.classList.remove('hidden');
      trigger.classList.add('hidden');
    });
  }
</script>