---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import Container from '../layout/Container.astro';
import { config } from '@/data/config';
---

<section class="relative overflow-hidden bg-void py-24 sm:py-32 lg:py-40">
  <!-- Ambient Glow & Grid Background -->
  <div class="absolute inset-0 -z-10">
    <div class="ark-glow absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full opacity-50"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.04)_1px,transparent_0)] bg-[size:32px_32px]"></div>
  </div>

  <Container class="text-center">
    <Badge class="mb-6">{config.brand.name}</Badge>

    <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl animate-fade-up">
      {config.brand.tagline}
    </h1>

    <p
      class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-zinc-400 animate-fade-up"
      style="animation-delay: 100ms;"
    >
      {config.hero.subheadline}
    </p>

    <div
      class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up"
      style="animation-delay: 200ms;"
    >
      <Button variant="primary" href={config.hero.primaryCta.href}>
        {config.hero.primaryCta.label}
      </Button>
      <Button variant="secondary" href={config.hero.secondaryCta.href}>
        {config.hero.secondaryCta.label}
      </Button>
    </div>

    <dl
      class="mx-auto mt-16 grid max-w-3xl grid-cols-3 gap-6 animate-fade-up"
      style="animation-delay: 300ms;"
    >
      {config.hero.stats.map((stat) => (
        <div>
          <dt class="text-sm text-zinc-400">{stat.label}</dt>
          <dd class="mt-1 text-3xl font-bold text-white">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
