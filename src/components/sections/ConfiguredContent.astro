---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { config } from '@/data/config';
---

<Section variant="default" padding="lg" id="problema">
  <Container>
    <div class="grid gap-6 md:grid-cols-3">
      {config.problems.map((problem) => (
        <Card
          class={`flex flex-col p-6 ${problem.highlight ? 'border-ark-accent/30 shadow-ark-glow' : ''}`}
        >
          <div class="flex items-center justify-between gap-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-zinc-400">
              {problem.label}
            </p>
            {problem.badge && <Badge>{problem.badge}</Badge>}
          </div>
          <h2 class="mt-4 text-xl font-semibold text-white">{problem.title}</h2>
          <ul class="mt-5 flex-1 space-y-3">
            {problem.bullets.map((bullet) => (
              <li class="flex gap-2 text-sm text-zinc-300">
                <span aria-hidden="true" class="text-ark-accent">
                  •
                </span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 border-t border-white/10 pt-4 text-sm text-zinc-400">{problem.cost}</p>
        </Card>
      ))}
    </div>
  </Container>
</Section>

<Section variant="surface" padding="lg" id="como">
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <Badge class="mb-4">{config.how.label}</Badge>
      <h2 class="text-3xl font-bold text-white sm:text-4xl">{config.how.headline}</h2>
      <p class="mt-4 text-zinc-400">{config.how.subheadline}</p>
    </div>
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {config.how.steps.map((step) => (
        <li>
          <Card class="h-full p-6">
            <span class="font-mono text-sm text-ark-accent">{step.n}</span>
            <h3 class="mt-4 text-lg font-semibold text-white">{step.title}</h3>
            <p class="mt-3 text-sm text-zinc-400">{step.desc}</p>
            <p class="mt-5 text-xs font-medium uppercase tracking-wide text-zinc-500">
              {step.meta}
            </p>
          </Card>
        </li>
      ))}
    </ol>
    <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-zinc-400">{config.how.rule}</p>
  </Container>
</Section>

<Section variant="default" padding="lg" id="para-que">
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Para quién sirve</h2>
      <p class="mt-4 text-zinc-400">{config.useCases.intro}</p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {config.useCases.items.map((useCase) => (
        <Card class="p-6">
          <Badge class="mb-4">{useCase.tag}</Badge>
          <p class="text-sm text-zinc-500">{useCase.before}</p>
          <p class="mt-3 text-sm font-medium text-white">{useCase.after}</p>
        </Card>
      ))}
    </div>
  </Container>
</Section>

<Section variant="surface" padding="lg" id="costos">
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <Badge class="mb-4">{config.costs.badge}</Badge>
      <h2 class="text-3xl font-bold text-white sm:text-4xl">{config.costs.headline}</h2>
      <p class="mt-4 text-sm text-zinc-400">{config.costs.disclaimer}</p>
    </div>
    <div class="mx-auto mt-8 max-w-4xl overflow-x-auto rounded-2xl border border-white/10">
      <table class="w-full min-w-[36rem] text-left text-sm">
        <thead class="bg-white/[0.04] text-zinc-300">
          <tr>
            <th scope="col" class="p-4">
              Concepto
            </th>
            <th scope="col" class="p-4">
              WP / Wix
            </th>
            <th scope="col" class="p-4">
              Ark
            </th>
          </tr>
        </thead>
        <tbody>
          {config.costs.rows.map((row) => (
            <tr class="border-t border-white/10">
              <th scope="row" class="p-4 font-medium text-white">
                {row.concept}
              </th>
              <td class="p-4 text-zinc-400">{row.wpWix}</td>
              <td class="p-4 text-zinc-300">{row.ark}</td>
            </tr>
          ))}
        </tbody>
        <tfoot class="border-t border-white/10 bg-white/[0.04]">
          <tr>
            <th scope="row" class="p-4 text-white">
              Total
            </th>
            <td class="p-4 text-zinc-400">{config.costs.total.wpWix}</td>
            <td class="p-4 font-semibold text-ark-accent">{config.costs.total.ark}</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </Container>
</Section>
