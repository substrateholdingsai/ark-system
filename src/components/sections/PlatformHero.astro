---
import { platform } from '@/data/config';

const splineUrl = 'https://my.spline.design/untitled-fKJICKEX47H5F37XSO72UqvD/';

const coreLayers = [
  { num: '01', name: 'Ark Ledger', desc: 'CFDI 4.0 & Fiscal', tag: 'arkledger.site' },
  { num: '02', name: 'Ark Angel', desc: 'Recepcionista Voz IA', tag: 'arkangel.site' },
  { num: '03', name: 'Ark Commerce', desc: 'Storefront + Chat IA', tag: 'arkcommerce.site' },
  { num: '04', name: 'Ark Sales', desc: '4 Agentes Autónomos', tag: 'arksales.site' },
];

const satelliteLayers = [
  { name: 'Sentinela', sub: 'Compliance AI' },
  { name: 'Ark Hermes', sub: 'PropTech USA' },
  { name: 'Legaltech', sub: 'Firma NOM-151' },
];
---

<section
  id="platform-hero"
  class="relative overflow-hidden border-b border-eterea-border px-6 pb-20 pt-14 md:pt-20"
  style="background: radial-gradient(circle at 20% 10%, #EAF2FF 0%, #F8FBFF 55%, #FFFFFF 100%);"
>
  <div
    class="pointer-events-none absolute -top-28 right-1/4 h-[520px] w-[520px] rounded-full opacity-55 blur-3xl"
    style="background: radial-gradient(circle, #BFDBFE 0%, rgba(191,219,254,0) 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl">
    <!-- Status Badge -->
    <div class="mb-8 inline-flex flex-wrap items-center gap-2.5 rounded-full border border-[#DCE7FF] bg-white px-3.5 py-1.5 shadow-sm">
      <span class="h-2 w-2 animate-pulse rounded-full bg-eterea-blue"></span>
      <span class="mono text-xs font-medium text-eterea-blue">
        ARK PLATFORM · 7 PRODUCTOS EN PRODUCCIÓN
      </span>
      <span class="text-xs text-slate-300">|</span>
      <span class="text-xs text-slate-600">Edge-native en Cloudflare</span>
    </div>

    <div class="grid items-center gap-12 lg:grid-cols-12">
      <!-- Left: Editorial Headline + CTAs -->
      <div class="lg:col-span-6">
        <h1 class="instrument text-5xl leading-[1.03] tracking-tight text-eterea-text sm:text-6xl lg:text-[68px]">
          El back-office <span class="italic text-eterea-blue">agéntico</span> de los servicios profesionales mexicanos.
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-eterea-muted sm:text-xl">
          Siete productos en la nube sobre <strong class="font-medium text-slate-800">un solo motor operativo</strong>.
          Facturación CFDI 4.0, recepcionista de voz IA, comercio conversacional, prospección autónoma e inteligencia regulatoria — integrados de fábrica con auditoría criptográfica <span class="mono text-sm text-slate-700">SHA-256</span>.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3.5">
          <a
            href="#product-matrix"
            class="inline-flex items-center gap-2 rounded-xl bg-eterea-blue px-6 py-3.5 text-sm font-medium text-white shadow-eterea-btn transition-all hover:bg-blue-700"
          >
            Explorar los 7 productos
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="#casos-de-exito"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-6 py-3.5 text-sm font-medium text-slate-800 transition-all hover:border-blue-300 hover:bg-slate-50"
          >
            Ver casos de éxito (CANACO & Futura)
          </a>
        </div>

        <!-- Micro trust line -->
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-500">
          <span class="inline-flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            CFDI 4.0 timbrado real (Facturapi)
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Firma electrónica NOM-151
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Sin "contact us for pricing"
          </span>
        </div>
      </div>

      <!-- Right: Interactive Spline 3D Architecture + Layer Switcher -->
      <div class="lg:col-span-6">
        <div class="relative rounded-3xl border border-[#DCE7FF] bg-white/95 p-4 shadow-eterea-hero backdrop-blur sm:p-5">
          <!-- Card Header with View Toggle -->
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-blue-500"></span>
              <span class="mono text-[11px] font-medium tracking-wider text-slate-700">
                ARQUITECTURA INTERACTIVA · 7 CAPAS
              </span>
            </div>
            <div class="inline-flex rounded-lg border border-blue-100 bg-[#F5F8FF] p-0.5">
              <button
                type="button"
                data-hero-tab="3d"
                class="hero-tab-btn rounded-md bg-eterea-blue px-2.5 py-1 mono text-[10px] font-medium text-white transition-all"
              >
                ESCENA 3D SPLINE
              </button>
              <button
                type="button"
                data-hero-tab="diagram"
                class="hero-tab-btn rounded-md px-2.5 py-1 mono text-[10px] font-medium text-slate-600 transition-all hover:text-eterea-blue"
              >
                VISTA ESQUEMÁTICA
              </button>
            </div>
          </div>

          <!-- Panel 1: Live Spline 3D Scene -->
          <div id="hero-panel-3d" class="relative overflow-hidden rounded-2xl border border-[#0F1D3A] bg-[#0C1528]">
            <div class="relative aspect-[4/3] w-full sm:aspect-[16/11]">
              <iframe
                src={splineUrl}
                title="Arquitectura 3D Ark Systems — 7 productos sobre un solo motor operativo"
                class="h-full w-full border-0"
                loading="eager"
                allow="autoplay; fullscreen; xr-spatial-tracking"
              ></iframe>
              <!-- Mask cover for Spline watermark in free embed -->
              <div
                class="pointer-events-none absolute bottom-3 right-3 h-10 w-36 rounded-xl bg-[#0C1528] opacity-95 transition-opacity"
                aria-hidden="true"
              ></div>
            </div>

            <!-- Floating overlay legend at bottom of 3D canvas -->
            <div class="flex flex-wrap items-center justify-between gap-2 border-t border-white/10 bg-[#0A1222]/90 px-3.5 py-2 text-[11px] text-slate-300 backdrop-blur">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-sky-400"></span>
                <span class="mono text-[10px] text-sky-300">MOTOR OPERATIVO · SHA-256</span>
              </div>
              <span class="mono text-[10px] text-slate-400">
                Arrastra para rotar · Scroll para zoom
              </span>
            </div>
          </div>

          <!-- Panel 2: Schematic Layer Stack (Fallback / Quick Inspector) -->
          <div id="hero-panel-diagram" class="hidden space-y-2.5 pt-1">
            {coreLayers.map((layer) => (
              <a
                href={`https://${layer.tag}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between rounded-xl border border-[#E5EEFF] bg-gradient-to-r from-[#F8FBFF] to-white px-3.5 py-2.5 transition-all hover:border-blue-400"
              >
                <div class="flex items-center gap-3">
                  <span class="mono rounded bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-600">
                    {layer.num}
                  </span>
                  <div>
                    <div class="text-sm font-semibold text-slate-900 group-hover:text-blue-600">
                      {layer.name}
                    </div>
                    <div class="text-xs text-slate-500">{layer.desc}</div>
                  </div>
                </div>
                <span class="mono rounded-md border border-slate-200 bg-white px-2 py-0.5 text-[11px] text-slate-600">
                  {layer.tag} ↗
                </span>
              </a>
            ))}

            <div class="grid grid-cols-3 gap-2 pt-1">
              {satelliteLayers.map((sat) => (
                <div class="rounded-xl border border-slate-200/80 bg-slate-50/90 p-2.5 text-center">
                  <div class="text-xs font-semibold text-slate-800">{sat.name}</div>
                  <div class="mono mt-0.5 text-[10px] text-blue-600">{sat.sub}</div>
                </div>
              ))}
            </div>
          </div>

          <!-- Substrate Base Pill -->
          <div class="mt-3 rounded-2xl bg-gradient-to-r from-blue-600 to-blue-500 p-3.5 text-white shadow-md">
            <div class="flex items-center justify-between">
              <span class="mono text-[10px] uppercase tracking-widest text-blue-100">
                MOTOR OPERATIVO COMPARTIDO
              </span>
              <span class="mono rounded bg-white/15 px-2 py-0.5 text-[10px]">
                SHA-256 AUDIT CHAIN
              </span>
            </div>
            <div class="mt-1.5 flex flex-wrap gap-1.5 text-[11px] font-medium">
              <span class="rounded bg-white/15 px-2 py-0.5">Identidad Única</span>
              <span class="rounded bg-white/15 px-2 py-0.5">Base de Datos Edge</span>
              <span class="rounded bg-white/15 px-2 py-0.5">Bóveda Fiscal</span>
              <span class="rounded bg-white/15 px-2 py-0.5">IA & Voz</span>
              <span class="rounded bg-white/15 px-2 py-0.5">Stripe Connect</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Proof Points Strip (4 Metric Cards) -->
    <div class="mt-16 grid grid-cols-2 gap-4 md:grid-cols-4">
      {platform.proofPoints.map((m) => (
        <a
          href={m.href}
          class="group rounded-2xl border border-[#E6EEFF] bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-eterea-card"
        >
          <div class="instrument text-3xl text-slate-900 transition-colors group-hover:text-eterea-blue sm:text-4xl">
            {m.value}
          </div>
          <div class="mt-1 text-sm font-medium text-slate-800">{m.label}</div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-hero-tab]');
  const panel3d = document.getElementById('hero-panel-3d');
  const panelDiagram = document.getElementById('hero-panel-diagram');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-hero-tab');
      tabBtns.forEach((b) => {
        const active = b.getAttribute('data-hero-tab') === target;
        b.classList.toggle('bg-eterea-blue', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('text-slate-600', !active);
      });
      if (target === '3d') {
        panel3d?.classList.remove('hidden');
        panelDiagram?.classList.add('hidden');
      } else {
        panel3d?.classList.add('hidden');
        panelDiagram?.classList.remove('hidden');
      }
    });
  });
</script>
