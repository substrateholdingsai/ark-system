---
import Nav from './Nav.astro';
import Button from '../ui/Button.astro';
import { config } from '@/data/config';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-white/[0.08] bg-base/80 backdrop-blur-lg">
  <div class="mx-auto flex h-16 max-w-ark-container items-center justify-between px-6 sm:px-8">
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2 text-xl font-display font-bold tracking-tight text-white transition-opacity hover:opacity-80"
    >
      <img src={config.brand.logoSrc} alt="" class="h-8 w-8" />
      <span>{config.brand.displayName}</span>
    </a>

    <!-- Navigation (Desktop + Mobile) -->
    <Nav links={config.nav} currentPath={currentPath} />

    <!-- CTA Button -->
    <div class="hidden sm:block">
      <Button
        variant={
          config.hero.primaryCta.variant === 'ghost' ? 'ghost' : config.hero.primaryCta.variant
        }
        href={config.hero.primaryCta.href}
        target={config.hero.primaryCta.external ? '_blank' : undefined}
        rel={config.hero.primaryCta.external ? 'noopener noreferrer' : undefined}
      >
        {config.hero.primaryCta.label}
      </Button>
    </div>
  </div>
</header>
