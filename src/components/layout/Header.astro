---
import Nav from './Nav.astro';
import Button from '../ui/Button.astro';
import ArkMark from '../brand/ArkMark.astro';
import { config } from '@/data/config';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-white/[0.08] bg-base/80 backdrop-blur-lg">
  <div class="mx-auto flex h-16 w-full max-w-ark-container items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2 text-xl font-display font-bold tracking-tight text-white transition-opacity hover:opacity-80"
    >
      <ArkMark class="h-8 w-auto" />
      <span>{config.brand.displayName}</span>
    </a>

    <!-- Navigation (Desktop + Mobile) -->
    <Nav links={config.nav} currentPath={currentPath} />

    <!-- CTA Button -->
    <div class="hidden sm:block">
      <Button variant="primary" href="/contact#booking">
        Agendar asesoría
      </Button>
    </div>
  </div>
</header>
