---
import Container from './Container.astro';
import { config } from '@/data/config';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.08] bg-void py-12">
  <Container>
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <!-- Brand & Copyright -->
      <div class="text-center sm:text-left">
        <p class="text-sm font-semibold text-white">{config.brand.name}</p>
        <p class="mt-1 text-xs text-zinc-500">
          © {currentYear} {config.brand.name}. All rights reserved.
        </p>
      </div>

      <!-- Links -->
      <div class="flex gap-6">
        <a href="/portfolio" class="text-sm text-zinc-400 transition-colors hover:text-white">
          Portfolio
        </a>
        <a href="/pricing" class="text-sm text-zinc-400 transition-colors hover:text-white">
          Pricing
        </a>
        <a
          href={config.contact.calComLink}
          class="text-sm text-zinc-400 transition-colors hover:text-white"
        >
          Contact
        </a>
      </div>
    </div>
  </Container>
</footer>
