---
import Container from './Container.astro';
import { config } from '@/data/config';

const currentYear = new Date().getFullYear();
const copyright = config.footer.copyright.replace(/© \d{4}/, `© ${currentYear}`);
const whatsappNumber = config.contact.whatsapp?.replace(/\D/g, '');
const whatsappMessage = encodeURIComponent(
  'Hola Pavel, me interesa una demo de 3 minutos de Ark Legal para mi despacho.',
);
const businessLines = config.lines.map((line) => ({
  ...line,
  href: `/portfolio#line-${line.id}`,
}));
---

<footer
  data-theme={config.theme.default}
  class="border-t border-white/[0.06] bg-void py-12 text-zinc-400 sm:py-16"
>
  <Container>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="space-y-4 lg:col-span-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-base font-black tracking-wider text-white"
        >
          <img src={config.brand.logoSrc} alt="" class="h-6 w-6" />
          <span>{config.brand.displayName}</span>
        </a>

        <p class="max-w-sm text-xs leading-relaxed text-zinc-400">{config.footer.tagline}</p>

        <div class="flex items-center gap-2 text-[11px] text-zinc-500">
          <span class="h-1.5 w-1.5 rounded-full bg-[#F38020]"></span>
          <span class="font-mono">{config.footer.foundation}</span>
        </div>

        <p class="text-[11px] text-zinc-600">{copyright}. Todos los derechos reservados.</p>
      </div>

      <div class="space-y-3 lg:col-span-2">
        <p class="text-xs font-bold uppercase tracking-widest text-white">Líneas</p>
        <ul class="space-y-2 text-xs">
          {businessLines.map((line) => (
            <li>
              <a href={line.href} class="transition-colors hover:text-white">
                {line.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-3 lg:col-span-3">
        <p class="text-xs font-bold uppercase tracking-widest text-white">Navegación</p>
        <ul class="space-y-2 text-xs">
          {config.nav
            .filter((link) => ['/#que-es', '/#como', '/#pricing', '/portfolio'].includes(link.href))
            .map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-white">
                  {link.href === '/#pricing'
                    ? 'Modelos de arrendamiento'
                    : link.href === '/portfolio'
                      ? 'Portafolio'
                      : link.href === '/#como'
                        ? 'Cómo funciona'
                        : 'Qué es'}
                </a>
              </li>
            ))}
          <li>
            <a href="/contact" class="transition-colors hover:text-white">
              Contacto
            </a>
          </li>
        </ul>
      </div>

      <div class="space-y-3 lg:col-span-3">
        <p class="text-xs font-bold uppercase tracking-widest text-white">Contacto & Canales</p>

        <ul class="space-y-2.5 text-xs">
          <li>
            <a
              href={`https://${config.brand.domain}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-zinc-300 transition-colors hover:text-ark-accent"
            >
              <span class="text-zinc-500" aria-hidden="true">
                🌐
              </span>
              {config.brand.domain}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${config.contact.email}`}
              class="inline-flex items-center gap-2 text-zinc-300 transition-colors hover:text-ark-accent"
            >
              <span class="text-zinc-500" aria-hidden="true">
                ✉️
              </span>
              {config.contact.email}
            </a>
          </li>
          {whatsappNumber && config.contact.whatsapp && (
            <li>
              <a
                href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-zinc-300 transition-colors hover:text-emerald-400"
              >
                <span class="text-emerald-500" aria-hidden="true">
                  💬
                </span>
                WhatsApp
              </a>
            </li>
          )}
          {config.contact.x && (
            <li>
              <a
                href={config.contact.x}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-zinc-300 transition-colors hover:text-white"
              >
                <span class="text-zinc-500" aria-hidden="true">
                  𝕏
                </span>
                X (Twitter)
              </a>
            </li>
          )}
        </ul>

        <p class="pt-2 text-[10px] leading-relaxed text-zinc-500">
          Las demos y sus datos son ilustrativos cuando así se indica. El contenido no constituye
          asesoría legal, fiscal ni profesional.
        </p>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/[0.06] pt-6 text-[10px] text-zinc-500 sm:flex-row">
      <p>Infraestructura digital para profesionales y negocios.</p>
      <div class="flex items-center gap-3 font-mono text-zinc-400">
        <span class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400"></span>
          <span>{config.footer.tech}</span>
        </span>
        <span class="text-zinc-700">·</span>
        <span class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-[#F38020]"></span>
          <span>Cloudflare Edge</span>
        </span>
      </div>
    </div>
  </Container>
</footer>
