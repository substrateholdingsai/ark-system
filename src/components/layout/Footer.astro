---
import Container from './Container.astro';
import { config } from '@/data/config';
---

<footer class="border-t border-white/[0.08] bg-void py-12">
  <Container>
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <!-- Brand & Copyright -->
      <div class="text-center sm:text-left">
        <p class="text-sm font-semibold text-white">{config.brand.displayName}</p>
        <p class="mt-1 text-xs text-zinc-500">{config.footer.copyright}</p>
        <p class="mt-1 text-xs text-zinc-500">{config.footer.tagline}</p>
        <p class="mt-1 text-xs text-zinc-600">{config.footer.tech}</p>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap gap-6">
        {config.nav.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="text-sm text-zinc-400 transition-colors hover:text-white"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </Container>
</footer>
