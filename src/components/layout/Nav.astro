---
import type { NavLink } from '@/data/config';
import { config } from '@/data/config';

interface Props {
  links: NavLink[];
  currentPath?: string;
  class?: string;
}

const { links, currentPath = '/', class: className = '' } = Astro.props;

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  const normalized = normalize(href);
  const current = normalize(currentPath);
  return current === normalized || current.startsWith(`${normalized}/`);
};

const linesWithProducts = config.lines.map((line) => ({
  ...line,
  href: `/portfolio#line-${line.id}`,
  products: config.portfolio.flatMap((item) => {
    if (item.line !== line.id || !item.url || item.available === false) return [];

    return [
      {
        name: item.name,
        href: item.url,
        description:
          item.description.length > 60
            ? `${item.description.slice(0, 57).trimEnd()}...`
            : item.description,
        external: item.url.startsWith('http'),
      },
    ];
  }),
}));

const lineHrefs = new Set(linesWithProducts.map((line) => line.href));
const mainLinks = links.filter((link) => !lineHrefs.has(link.href) && link.href !== '/');
---

<nav
  class={`flex items-center gap-2 ${className}`}
  aria-label="Navegación principal"
  data-ark-nav
  data-theme={config.theme.default}
>
  <ul class="hidden items-center gap-1 lg:flex">
    {linesWithProducts.map((line) => (
      <li class="group relative" data-nav-dropdown data-theme={line.id}>
        <a
          href={line.href}
          class:list={[
            'inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-bold tracking-wide text-zinc-400 transition-colors duration-200 ease-ark hover:text-white',
            isActive(line.href) && 'text-white',
          ]}
          aria-haspopup="true"
          aria-expanded="false"
          data-nav-trigger
        >
          <span class="h-1.5 w-1.5 rounded-full bg-ark-accent" aria-hidden="true"></span>
          {line.name}
          <svg
            class="h-3 w-3 transition-transform duration-200 group-hover:rotate-180"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <div
          data-nav-panel
          class="invisible absolute left-0 top-full z-50 mt-2 w-[320px] origin-top-left scale-95 opacity-0 transition-all duration-200 ease-ark group-hover:visible group-hover:scale-100 group-hover:opacity-100 group-focus-within:visible group-focus-within:scale-100 group-focus-within:opacity-100"
        >
          <div class="overflow-hidden rounded-xl border border-white/[0.08] bg-base/95 shadow-2xl backdrop-blur-xl">
            <div class="border-b border-white/[0.06] px-4 py-3">
              <div class="text-[10px] font-black uppercase tracking-widest text-zinc-500">
                {line.name}
              </div>
              <div class="mt-1 text-xs text-zinc-400">{line.tagline}</div>
            </div>

            <ul class="p-2">
              {line.products.map((product) => (
                <li>
                  <a
                    href={product.href}
                    target={product.external ? '_blank' : undefined}
                    rel={product.external ? 'noopener noreferrer' : undefined}
                    class="flex flex-col gap-0.5 rounded-lg px-3 py-2 transition-colors hover:bg-white/[0.04]"
                  >
                    <span class="text-sm font-medium text-white">{product.name}</span>
                    {product.description && (
                      <span class="line-clamp-1 text-[11px] text-zinc-500">
                        {product.description}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>

            <div class="border-t border-white/[0.06] p-2">
              <a
                href={line.href}
                class="flex items-center justify-between rounded-lg px-3 py-2 text-xs font-bold text-ark-accent transition-colors hover:bg-white/[0.04]"
              >
                Ver {line.name} completo
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </li>
    ))}

    {mainLinks.map((link) => (
      <li>
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          class:list={[
            'inline-flex items-center rounded-lg px-3 py-2 text-sm font-medium tracking-wide text-zinc-400 transition-colors duration-200 ease-ark hover:text-white',
            isActive(link.href) && 'text-white',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <button
    type="button"
    data-nav-toggle
    class="relative z-50 flex h-10 w-10 items-center justify-center rounded-full border border-white/[0.08] bg-surface/50 text-white backdrop-blur-md transition-all duration-300 ease-ark hover:bg-surface-hover focus:outline-none focus:ring-2 focus:ring-ark-accent/50 lg:hidden"
    aria-expanded="false"
    aria-controls="ark-mobile-menu"
    aria-label="Abrir menú"
  >
    <svg
      class="h-5 w-5"
      data-icon="open"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <svg
      class="hidden h-5 w-5"
      data-icon="close"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div
    id="ark-mobile-menu"
    data-nav-menu
    class="fixed inset-0 z-40 hidden flex-col overflow-y-auto bg-base/95 backdrop-blur-xl lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Navegación móvil"
  >
    <div class="flex min-h-full flex-col items-center justify-center gap-8 px-6 py-20">
      <ul class="flex w-full max-w-sm flex-col gap-2">
        {linesWithProducts.map((line) => (
          <li
            data-nav-mobile-section
            class="border-b border-white/[0.06] pb-2"
            data-theme={line.id}
          >
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 transition-colors hover:bg-white/[0.04]">
                <div class="flex items-center gap-2.5">
                  <span class="h-2 w-2 rounded-full bg-ark-accent" aria-hidden="true"></span>
                  <span class="font-display text-lg font-semibold tracking-tight text-white">
                    {line.name}
                  </span>
                </div>
                <svg
                  class="h-4 w-4 text-zinc-500 transition-transform group-open:rotate-180"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <ul class="mt-1 flex flex-col gap-0.5 pb-1 pl-6">
                <li>
                  <a
                    href={line.href}
                    data-nav-link
                    class="block rounded-lg px-3 py-2 text-sm font-semibold text-ark-accent transition-colors hover:bg-white/[0.04]"
                  >
                    Ver línea completa
                  </a>
                </li>
                {line.products.map((product) => (
                  <li>
                    <a
                      href={product.href}
                      target={product.external ? '_blank' : undefined}
                      rel={product.external ? 'noopener noreferrer' : undefined}
                      data-nav-link
                      class="block rounded-lg px-3 py-2 text-sm text-zinc-400 transition-colors hover:bg-white/[0.04] hover:text-white"
                    >
                      {product.name}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))}

        {mainLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              data-nav-link
              class:list={[
                'block rounded-lg px-3 py-3 font-display text-lg font-semibold tracking-tight text-white transition-colors hover:bg-white/[0.04] hover:text-ark-accent',
                isActive(link.href) && 'text-ark-accent',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/contact#booking"
        data-nav-link
        class="ark-btn-primary inline-flex min-h-11 items-center justify-center rounded-full px-6 text-sm font-semibold"
      >
        Agendar asesoría
      </a>
    </div>
  </div>
</nav>

<script>
  const initNav = (nav: HTMLElement) => {
    const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const menu = nav.querySelector<HTMLElement>('[data-nav-menu]');
    if (!toggle || !menu) return;

    document.body.append(menu);

    const iconOpen = toggle.querySelector('[data-icon="open"]');
    const iconClose = toggle.querySelector('[data-icon="close"]');
    const links = menu.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const getFocusableElements = () =>
      menu.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])'
      );

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    const close = () => {
      setOpen(false);
      toggle.focus();
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
      if (!open) requestAnimationFrame(() => getFocusableElements()[0]?.focus());
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') close();
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || toggle.getAttribute('aria-expanded') !== 'true') return;

      const focusableElements = getFocusableElements();
      const firstElement = focusableElements[0];
      const lastElement = focusableElements[focusableElements.length - 1];

      if (event.shiftKey && document.activeElement === firstElement) {
        event.preventDefault();
        lastElement?.focus();
      } else if (!event.shiftKey && document.activeElement === lastElement) {
        event.preventDefault();
        firstElement?.focus();
      }
    });

    links.forEach((link) => link.addEventListener('click', close));
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });

    nav.querySelectorAll<HTMLElement>('[data-nav-dropdown]').forEach((dropdown) => {
      const trigger = dropdown.querySelector<HTMLAnchorElement>('[data-nav-trigger]');
      if (!trigger) return;

      dropdown.addEventListener('focusin', () => {
        trigger.setAttribute('aria-expanded', 'true');
      });
      dropdown.addEventListener('focusout', (event) => {
        if (!dropdown.contains(event.relatedTarget as Node | null)) {
          trigger.setAttribute('aria-expanded', 'false');
        }
      });
    });
  };

  document.querySelectorAll<HTMLElement>('[data-ark-nav]').forEach(initNav);
</script>
