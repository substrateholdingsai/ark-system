---
interface Props {
  /** 'prose' = 65ch, 'container' = 1280px (default), 'full' = 100% width */
  size?: 'prose' | 'container' | 'full';
  class?: string;
}

const { size = 'container', class: className = '' } = Astro.props;

const sizeClasses = {
  prose: 'w-full sm:max-w-ark-prose',
  container: 'w-full sm:max-w-ark-container',
  full: 'w-full',
};

const paddingClass = size === 'full' ? '' : 'px-4 sm:px-6 lg:px-8';
---

<div class={`mx-auto ${sizeClasses[size]} ${paddingClass} ${className}`}>
  <slot />
</div>
